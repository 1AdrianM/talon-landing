# Talon Landing — Variables de entorno
# Copia como .env.local para dev local
# En Vercel: configura por ambiente en el dashboard

# Backend URL (Fly.io)
# dev:  https://api-talon-dev.fly.dev
# qa:   https://api-talon-qa.fly.dev
# sta:  https://api-talon-sta.fly.dev
# prod: https://api-talon.fly.dev
PUBLIC_API_URL=

# 'mock' = demo data sin backend | 'live' = llama al backend real
# dev: mock | qa/sta/prod: live
PUBLIC_ANALYZER_MODE=mock

# API key para /api/v2/analyze (debe existir en Supabase)
PUBLIC_DEMO_KEY=
