# ── Talon Landing — Environment Variables ─────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# All PUBLIC_ vars are exposed to the browser (Astro convention).

# Backend API base URL (Fly.io deployment, no trailing slash)
PUBLIC_API_URL=https://api-talon.fly.dev

# Analyzer mode: 'mock' uses backend with demo data, 'live' hits real scraping
# Defaults to 'mock' in AnalyzerHero if not set
PUBLIC_ANALYZER_MODE=mock

# Demo API key — sent as Authorization: Bearer <key> on /api/v2/analyze
# Must exist in Supabase api_keys table
PUBLIC_DEMO_KEY=your_demo_key_here
