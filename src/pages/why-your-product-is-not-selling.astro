---
import Layout from '../layouts/Layout.astro';
import SeoPage from '../components/SeoPage.astro';

const pageTitle = "Why Your Product Is Not Selling — Price Analysis";
const pageDescription = "Find out why your products aren't selling. Analyze your pricing vs competitors and get actionable recommendations to recover sales.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <SeoPage
    title={pageTitle}
    description={pageDescription}
    slug="why-your-product-is-not-selling"
    heroEyebrow="Price Diagnosis"
    heroHeadline="Your product isn't selling? It's probably your price."
    heroSubheadline="Paste your product URL and get a clear verdict: raise, drop, or hold."
    ctaPrimary="Diagnose my price"
  />
</Layout>