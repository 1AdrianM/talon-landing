---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/landing/Footer.astro';

const apiUrl    = import.meta.env.PUBLIC_API_URL    ?? '';
const demoKey   = import.meta.env.PUBLIC_DEMO_KEY   ?? '';
const mode      = import.meta.env.PUBLIC_ANALYZER_MODE ?? 'mock';
---

<Layout
  title="Resultado · Talon"
  description="Análisis de tu precio frente a la competencia. Gratis, sin registro."
  noindex={true}
  lang="es"
>
  <!-- Header -->
  <header class="res-header">
    <a href="/" class="res-logo" aria-label="Volver a inicio">Talon</a>
    <span class="res-header-note">Análisis gratis · sin registro</span>
  </header>

  <!-- URL input bar -->
  <div class="res-bar">
    <form class="res-bar-form" id="res-bar-form">
      <input
        id="res-url"
        type="url"
        name="url"
        aria-label="URL de tu producto"
        autocomplete="url"
        class="mono res-url-input"
        placeholder="mitienda.com/products/product-name"
      />
      <button type="submit" class="res-recheck-btn">Revisar otro</button>
    </form>
  </div>

  <!-- States -->
  <main class="res-main" id="res-main" aria-live="polite">
    <!-- Loading -->
    <div class="res-state" id="state-loading">
      <div class="res-spinner" aria-hidden="true"></div>
      <p class="res-loading-text">Analizando tu precio…</p>
    </div>

    <!-- Error: not readable -->
    <div class="res-state hidden" id="state-error-not-readable">
      <div class="res-card res-error-card">
        <b class="res-error-title">No pudimos leer el precio de esa página.</b>
        <span class="res-error-body">Puede pasar por una de estas razones:</span>
        <ul class="res-error-list">
          <li>La tienda no es Shopify (por ahora solo leemos Shopify).</li>
          <li>La tienda tiene contraseña o bloquea lectores automáticos.</li>
          <li>El link no es de un producto.</li>
        </ul>
        <a href="/analizar" class="res-retry-btn">Probar con otro link</a>
      </div>
    </div>

    <!-- Error: rate limit -->
    <div class="res-state hidden" id="state-error-rate-limit">
      <div class="res-card res-error-card">
        <b class="res-error-title">Hiciste varios análisis en poco tiempo.</b>
        <span class="res-error-body">Para no sobrecargar las tiendas, espera un minuto y vuelve a intentar. Si prefieres, déjanos tu correo y te avisamos cuando abramos cupo.</span>
        <form class="res-rl-form" id="res-rl-form" novalidate>
          <input type="email" id="res-rl-email" name="email" placeholder="tu@email.com" class="res-rl-input" autocomplete="email" required />
          <button type="submit" class="af-btn-sm">Avisarme</button>
        </form>
        <span class="res-rl-note" id="res-rl-status" aria-live="polite"></span>
      </div>
    </div>

    <!-- Error: generic / timeout -->
    <div class="res-state hidden" id="state-error">
      <div class="res-error-icon" aria-hidden="true">⚠</div>
      <p class="res-error-msg" id="error-msg">No pudimos analizar este producto.</p>
      <a href="/analizar" class="res-error-back">Intentar de nuevo</a>
    </div>

    <!-- No competitors -->
    <div class="res-state hidden" id="state-no-competitors">
      <div class="res-product">
        <h1 class="res-product-name" id="nc-product-name">—</h1>
        <span class="mono res-product-meta">leído de tu tienda · precio real</span>
      </div>
      <div class="res-card nc-price-card">
        <span class="mono res-card-eyebrow">tu precio actual</span>
        <div class="nc-price" id="nc-current-price">—</div>
        <p class="nc-hint">Añade las URLs de los competidores para ver dónde estás parado en el mercado.</p>
      </div>
      <div class="res-card">
        <span class="mono res-card-eyebrow">competidores — hasta 3 URLs de Shopify</span>
        <form id="nc-form" class="nc-form">
          <input id="nc-c1" type="url" placeholder="https://competidor1.com/products/…" class="nc-input" autocomplete="off" />
          <input id="nc-c2" type="url" placeholder="https://competidor2.com/products/…" class="nc-input" autocomplete="off" />
          <input id="nc-c3" type="url" placeholder="https://competidor3.com/products/…" class="nc-input" autocomplete="off" />
          <button type="submit" class="nc-submit">Comparar precios →</button>
        </form>
      </div>
    </div>

    <!-- Result -->
    <div class="res-state hidden" id="state-result">
      <!-- Product name + meta -->
      <div class="res-product">
        <h1 class="res-product-name" id="res-product-name">—</h1>
        <span class="mono res-product-meta" id="res-product-meta">revisado hace unos segundos</span>
      </div>

      <!-- Partial warning (hidden when not partial) -->
      <div class="res-partial-banner hidden" id="res-partial-banner" role="status">
        <span class="res-partial-icon" aria-hidden="true">!</span>
        <div>
          <b id="res-partial-title">Solo pudimos comparar algunos competidores.</b>
          <span id="res-partial-detail" class="res-partial-detail">Los demás no se pudieron leer o están en otra moneda. El veredicto usa solo los comparables.</span>
        </div>
      </div>

      <!-- Verdict card -->
      <div class="res-card" id="res-verdict">
        <span class="mono res-card-eyebrow">veredicto</span>
        <div class="res-verdict-headline" id="res-verdict-headline">—</div>
        <div class="res-verdict-detail" id="res-verdict-detail"></div>
        <div class="res-verdict-action" id="res-verdict-action"></div>
      </div>

      <!-- Market scale card -->
      <div class="res-card" id="res-scale-card">
        <span class="mono res-card-eyebrow">dónde estás parado</span>
        <div class="res-scale" id="res-scale">
          <div class="res-scale-track"></div>
          <!-- markers injected by JS -->
        </div>
      </div>

      <!-- Competitor table -->
      <div class="res-card res-table-card">
        <div class="res-table-head" id="res-table-head">
          <span>vendedor</span>
          <span>precio</span>
          <span>vs. tú</span>
          <span id="res-table-col4">último cambio</span>
        </div>
        <div id="res-table-body"></div>
      </div>
    </div>
  </main>

  <!-- Waitlist CTA (dark, always visible) -->
  <section class="res-cta" aria-labelledby="res-cta-title">
    <div class="res-cta-left">
      <b class="res-cta-title" id="res-cta-title">Esto es una foto de hoy.</b>
      <span class="res-cta-sub">Talon revisa a estos competidores una vez al día (tú eliges la frecuencia) y te avisa cuando alguno se mueva, con el precio exacto que recomienda según tu margen real.</span>
    </div>
    <div class="res-cta-right">
      <form class="res-cta-form" id="res-cta-form" novalidate>
        <input
          id="res-cta-email"
          type="email"
          name="email"
          placeholder="tu@email.com"
          aria-label="Tu email"
          autocomplete="email"
          class="res-cta-input"
          required
        />
        <button type="submit" class="res-cta-btn">Avisarme</button>
      </form>
      <p class="res-cta-note" id="res-cta-status" aria-live="polite">Talon está en validación: entras a la lista de espera.</p>
    </div>
  </section>

  <div style="height: 60px;"></div>
  <Footer />
</Layout>

<!-- Pass env vars to client script -->
<script define:vars={{ apiUrl, demoKey, mode }}>
  // ── Helpers ──────────────────────────────────────────
  const STATE_IDS = ['state-loading','state-error','state-error-not-readable','state-error-rate-limit','state-no-competitors','state-result'];
  function show(id) {
    STATE_IDS.forEach(sid => document.getElementById(sid)?.classList.add('hidden'));
    document.getElementById(id)?.classList.remove('hidden');
  }
  function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }
  function setHTML(id, html) {
    const el = document.getElementById(id);
    if (el) el.innerHTML = html;
  }
  function fmt(n) {
    return '$' + Number(n).toFixed(2).replace(/\.00$/, '');
  }

  // ── Read URL + competitor params ─────────────────────
  const params     = new URLSearchParams(window.location.search);
  const productUrl = params.get('url') ?? '';
  const competitorUrls = [params.get('c1'), params.get('c2'), params.get('c3')].filter(Boolean);
  const urlInput   = document.getElementById('res-url');
  if (urlInput) urlInput.value = productUrl;

  // ── Navigate on re-check ──────────────────────────────
  document.getElementById('res-bar-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = urlInput?.value.trim() ?? '';
    window.location.href = val
      ? '/resultado?url=' + encodeURIComponent(val)
      : '/resultado';
  });

  // ── No-competitors form ───────────────────────────────
  document.getElementById('nc-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const c1 = (document.getElementById('nc-c1'))?.value.trim();
    const c2 = (document.getElementById('nc-c2'))?.value.trim();
    const c3 = (document.getElementById('nc-c3'))?.value.trim();
    const p = new URLSearchParams({ url: productUrl });
    if (c1) p.set('c1', c1);
    if (c2) p.set('c2', c2);
    if (c3) p.set('c3', c3);
    window.location.href = '/resultado?' + p.toString();
  });

  // ── Main analysis flow ────────────────────────────────
  async function analyze() {
    if (!productUrl) {
      show('state-error');
      setText('error-msg', 'Ingresa el link de un producto para analizar su precio.');
      return;
    }

    show('state-loading');

    try {
      const endpoint = (apiUrl || '') + '/api/v2/analyze';
      const body = { url: productUrl, ...(competitorUrls.length ? { competitors: competitorUrls } : {}) };
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (demoKey || ''),
        },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const status = res.status;
        if (status === 429) { show('state-error-rate-limit'); return; }
        if (status === 422 || (err.message ?? '').toLowerCase().includes('leer')) { show('state-error-not-readable'); return; }
        throw new Error(err.message ?? ('HTTP ' + status));
      }

      const data = await res.json();
      renderResult(data);

    } catch (err) {
      const msg = String(err?.message ?? err);
      if (msg.includes('not_readable') || msg.includes('422')) {
        show('state-error-not-readable');
      } else if (msg.includes('429') || msg.includes('rate')) {
        show('state-error-rate-limit');
      } else {
        show('state-error');
        if (msg.includes('401') || msg.includes('403')) {
          setText('error-msg', 'Error de autenticación. Recarga la página e inténtalo de nuevo.');
        } else if (msg.includes('400')) {
          setText('error-msg', 'Esta URL no parece ser de un producto Shopify. Revisa el link.');
        } else if (msg.includes('timeout') || msg.includes('408')) {
          setText('error-msg', 'Una de las páginas no respondió a tiempo. Inténtalo de nuevo.');
        } else {
          setText('error-msg', 'No pudimos analizar este producto. Inténtalo de nuevo más tarde.');
        }
      }
    }
  }

  // ── Render result ─────────────────────────────────────
  function renderResult(d) {
    // No competitors: show product + competitor input form
    if (d.no_competitors) {
      setText('nc-product-name', d.product_name || 'Tu producto');
      setText('nc-current-price', d.current_price ? fmt(d.current_price) : '—');
      show('state-no-competitors');
      return;
    }

    // Detect partial: some competitors have non-ok status
    const feed = d.feed_preview ?? [];
    const badStatuses = ['no_legible','moneda_distinta','timeout'];
    const hasPartial = feed.some(item => badStatuses.includes(item.status));
    const comparableCount = feed.filter(item => !item.status || item.status === 'ok').length;
    const totalCount = feed.length;
    const banner = document.getElementById('res-partial-banner');
    if (hasPartial && banner) {
      banner.classList.remove('hidden');
      setText('res-partial-title', `Solo pudimos comparar ${comparableCount} de ${totalCount} competidor${totalCount !== 1 ? 'es' : ''}.`);
      setText('res-partial-detail', 'Los demás no se pudieron leer o están en otra moneda. El veredicto usa solo los comparables.');
      const col4 = document.getElementById('res-table-col4');
      if (col4) col4.textContent = 'estado';
    } else if (banner) {
      banner.classList.add('hidden');
    }

    // Product name + meta
    const name = d.product_name || 'Tu producto';
    setText('res-product-name', name);
    const analyzed = d.competitors_analyzed ?? 0;
    let hostname = '';
    try { hostname = new URL(productUrl).hostname; } catch {}
    setText('res-product-meta', [
      hostname,
      'revisado hace unos segundos',
      analyzed > 0 ? analyzed + ' vendedores encontrados' : '',
    ].filter(Boolean).join(' · '));

    // Verdict — use real current price when available
    const yourPrice = d.current_price ?? d.suggested_price ?? d.recommended_price;
    // Backend: price_diff = (tuPrecio - mercado) / mercado × 100
    // → '+12%' = estás 12% SOBRE el mercado (bajar), '-8%' = BAJO el mercado (subir)
    const diff    = d.price_diff ?? '';
    const isOver  = diff.startsWith('+');   // tu precio está sobre el mercado
    const isUnder = diff.startsWith('-');   // tu precio está bajo el mercado

    let headline = '';
    let detail   = '';
    let action   = '';

    if (isOver) {
      const diffPct = diff.replace('+', '');
      headline = 'Tu precio está ' + diffPct + ' sobre el mercado.';
      detail   = d.insight ?? d.reason ?? '';
      action   = d.action ?? ('Bajar hacia ' + fmt(d.recommended_price));
    } else if (isUnder) {
      const diffPct = diff.replace('-', '');
      headline = 'Tu precio está ' + diffPct + ' por debajo del mercado.';
      detail   = d.insight ?? d.reason ?? '';
      action   = d.action ?? ('Subir hacia ' + fmt(d.recommended_price));
    } else {
      headline = 'Tu precio está en línea con el mercado.';
      detail   = d.insight ?? d.reason ?? '';
      action   = d.action ?? 'No se necesita acción inmediata.';
    }

    setText('res-verdict-headline', headline);
    setText('res-verdict-detail', detail);
    const arrowColor = isOver ? '#C1432E' : (isUnder ? '#2F9E66' : '#5b6270');
    const arrow      = isOver ? '↓'       : (isUnder ? '↑'       : '→');
    setHTML('res-verdict-action',
      `<span style="color:${arrowColor};font-weight:700">${arrow}</span> ${action}`
    );

    // Scale (using price_range)
    renderScale(d);

    // Table (using feed_preview)
    renderTable(d);

    show('state-result');
  }

  function renderScale(d) {
    const scale   = document.getElementById('res-scale');
    if (!scale) return;

    const min   = d.price_range?.min ?? d.recommended_price * 0.9;
    const max   = d.price_range?.max ?? d.recommended_price * 1.1;
    const yours = d.current_price ?? d.suggested_price ?? d.recommended_price;
    const rec   = d.recommended_price;
    const prices = [min, rec, max, yours].filter(Boolean);
    const allMin  = Math.min(...prices) * 0.95;
    const allMax  = Math.max(...prices) * 1.05;
    const range   = allMax - allMin || 1;
    const pct = (v) => ((v - allMin) / range * 100).toFixed(1) + '%';

    // Zone: suggested range
    const zoneLeft  = parseFloat(pct(min));
    const zoneRight = parseFloat(pct(max));
    const zoneW = (zoneRight - zoneLeft).toFixed(1) + '%';

    // Competitor markers from feed_preview
    const feed = d.feed_preview ?? [];
    const competitorMarkers = feed.slice(0, 4).map((item) => {
      const price = item.suggested_price ?? item.current_price ?? rec;
      const label = item.product_name ?? 'Competidor';
      return { price, label };
    });

    let html = `<div class="res-scale-track"></div>`;
    html += `<div class="res-scale-zone" style="left:${pct(min)};width:${zoneW}" title="Zona sugerida"></div>`;

    // Competitor dots
    competitorMarkers.forEach((c) => {
      html += `
        <div class="res-scale-mk" style="left:${pct(c.price)}">
          <span class="mono res-scale-price">${fmt(c.price)}</span>
          <span class="res-scale-dot"></span>
          <span class="res-scale-lbl">${c.label}</span>
        </div>`;
    });

    // Your price marker
    html += `
      <div class="res-scale-mk res-scale-mk--you" style="left:${pct(yours)}">
        <span class="mono res-scale-price you">${fmt(yours)} · tú</span>
        <span class="res-scale-dot you"></span>
      </div>`;

    // Zone label
    html += `<div class="res-scale-zone-lbl" style="left:${pct(min)};width:${zoneW}">zona sugerida</div>`;

    scale.innerHTML = html;
  }

  const STATUS_LABELS = {
    no_legible:      { text: 'No pudimos leer el precio', color: '#8a5a0b' },
    moneda_distinta: { text: 'Otra moneda, no comparable', color: '#8a5a0b' },
    timeout:         { text: 'No respondió a tiempo',     color: '#8a5a0b' },
  };

  function renderTable(d) {
    const tbody = document.getElementById('res-table-body');
    if (!tbody) return;
    const feedAll = d.feed_preview ?? [];
    const yours   = d.suggested_price ?? d.recommended_price;
    const isPartial = feedAll.some(item => ['no_legible','moneda_distinta','timeout'].includes(item.status));

    if (feedAll.length === 0) {
      tbody.innerHTML = '<div class="res-table-empty">No hay datos de competidores disponibles.</div>';
      return;
    }

    tbody.innerHTML = feedAll.slice(0, 5).map((item) => {
      const name  = item.competitor_name ?? item.store ?? item.product_name ?? 'Competidor';
      const bad   = STATUS_LABELS[item.status];

      if (bad) {
        return `
          <div class="res-table-row">
            <b class="res-row-name">${name}</b>
            <span class="mono" style="color:#8a93a3">—</span>
            <span class="mono" style="color:#8a93a3">—</span>
            <span class="res-row-change" style="color:${bad.color}">${bad.text}</span>
          </div>`;
      }

      const price    = item.current_price ?? item.competitor_price ?? item.suggested_price ?? 0;
      const diff     = price - yours;
      const diffStr  = (diff > 0 ? '+' : '') + fmt(diff);
      const diffColor = diff < 0 ? '#C1432E' : diff > 0 ? '#2F9E66' : '#5b6270';
      const col4     = isPartial ? 'ok' : (item.insight ?? item.reason ?? '—');
      const col4Html = isPartial
        ? `<span style="color:#2F9E66;font-weight:500;font-size:13px">leído hoy</span>`
        : `<span class="res-row-change">${col4}</span>`;

      return `
        <div class="res-table-row">
          <b class="res-row-name">${name}</b>
          <span class="mono">${fmt(price)}</span>
          <span class="mono" style="color:${diffColor}">${diffStr}</span>
          ${col4Html}
        </div>`;
    }).join('');
  }

  // Start analysis
  analyze();

  // ── Rate-limit email form ─────────────────────────────
  document.getElementById('res-rl-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = (document.getElementById('res-rl-email'))?.value.trim() ?? '';
    const statusEl = document.getElementById('res-rl-status');
    if (!statusEl) return;
    statusEl.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'resultado' }),
      });
      statusEl.textContent = res.ok
        ? '¡Listo! Te avisamos cuando abramos.'
        : 'Algo salió mal. Inténtalo de nuevo.';
      if (res.ok) statusEl.style.color = 'var(--cl-grn-dk)';
    } catch {
      statusEl.textContent = 'Error de red. Inténtalo de nuevo.';
    }
  });

  // ── Waitlist CTA form ──────────────────────────────────
  document.getElementById('res-cta-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = document.getElementById('res-cta-email')?.value.trim() ?? '';
    const statusEl = document.getElementById('res-cta-status');
    if (!statusEl) return;
    statusEl.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'resultado' }),
      });
      if (res.ok) {
        statusEl.textContent = '¡Listo! Te avisamos cuando abramos.';
        statusEl.style.color = 'var(--cl-grn-dk)';
      } else {
        statusEl.textContent = 'Algo salió mal. Inténtalo de nuevo.';
        statusEl.style.color = 'var(--cl-red-dk)';
      }
    } catch {
      statusEl.textContent = 'Error de red. Inténtalo de nuevo.';
      statusEl.style.color = 'var(--cl-red-dk)';
    }
  });
</script>

<style is:global>
  .hidden { display: none !important; }
</style>

<style>
  /* ── Page shell ── */
  :global(body) {
    background: var(--cl-bg); color: var(--cl-text);
    font-family: var(--cl-body); margin: 0; padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  /* Header */
  .res-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px var(--cl-gutter); border-bottom: 1px solid var(--cl-border);
    background: var(--cl-bg);
  }
  .res-logo {
    font-family: var(--cl-display); font-weight: 700; font-size: 18px;
    color: var(--cl-text); text-decoration: none; letter-spacing: -0.01em;
  }
  .res-header-note { font-size: 13px; color: var(--cl-subtle); }

  /* URL bar */
  .res-bar {
    padding: 20px var(--cl-gutter) 0;
    max-width: 720px;
  }
  .res-bar-form { display: flex; gap: 10px; }
  .res-url-input {
    flex: 1; padding: 12px 14px; border-radius: 8px;
    border: 1px solid var(--cl-border); background: #fff;
    font-size: 13.5px; color: var(--cl-text); outline: none;
    font-family: var(--cl-mono); font-variant-numeric: tabular-nums;
  }
  .res-url-input::placeholder { color: var(--cl-subtle); }
  .res-url-input:focus { border-color: var(--cl-cobalt); box-shadow: 0 0 0 3px rgba(47,82,214,.12); }
  .res-recheck-btn {
    padding: 12px 20px; border-radius: 8px;
    border: 1px solid var(--cl-border); background: none;
    color: var(--cl-text); font-size: 13.5px; font-weight: 500;
    font-family: var(--cl-body); cursor: pointer; white-space: nowrap;
    transition: background .15s;
  }
  .res-recheck-btn:hover { background: var(--cl-border); }

  /* Main area */
  .res-main {
    padding: 28px var(--cl-gutter) 0; min-height: 400px;
  }

  /* Loading */
  #state-loading {
    display: flex; flex-direction: column; align-items: center;
    gap: 20px; padding: 80px 0; text-align: center;
  }
  .res-spinner {
    width: 36px; height: 36px; border-radius: 50%;
