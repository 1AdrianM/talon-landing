---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Dashboard — Talon" noindex={true} description="Dashboard coming in early access.">
  <div style="min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:40px;text-align:center;font-family:var(--sans)">
    <p style="font-family:var(--mono);font-size:11px;color:var(--hold)">Coming soon</p>
    <h1 style="font-family:var(--display);font-size:28px;font-weight:700;color:var(--ink)">Dashboard is in early access</h1>
    <p style="font-size:14px;color:var(--ink-2);max-width:360px">Leave your email on the home page and we'll give you access when it's ready.</p>
    <a href="/#early-access" style="padding:12px 24px;background:var(--ink);color:var(--surface);border-radius:var(--radius);font-size:14px;font-weight:600;text-decoration:none">Get early access →</a>
  </div>
</Layout>
