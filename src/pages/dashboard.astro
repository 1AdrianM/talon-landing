---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard - Talon">
  <nav>
    <div class="container">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path d="M4 14L14 4L24 14L14 24L4 14Z" fill="url(#grad)" />
          <path d="M9 14L14 9L19 14L14 19L9 14Z" fill="#0a0e27" />
          <defs>
            <linearGradient id="grad" x1="4" y1="4" x2="24" y2="24">
              <stop stop-color="#06b6d4" />
              <stop offset="1" stop-color="#7c3aed" />
            </linearGradient>
          </defs>
        </svg>
        <span>TALON</span>
      </a>
      <div class="nav-right">
        <a href="/" class="nav-link">Home</a>
        <a href="/try" class="nav-link">Try Now</a>
        <a href="https://rapidapi.com/1AdrianM/api/price-tracking-api" target="_blank" class="btn-primary">Get API Key</a>
      </div>
    </div>
  </nav>

  <main class="dashboard-page">
    <div class="container">
      <div class="page-header">
        <h1>Your Tracked Products</h1>
        <a href="/try" class="analyze-link">+ Analyze another product</a>
      </div>

      <div class="dashboard-table" id="dashboard-table">
        <div class="table-header">
          <span>Product URL</span>
          <span>Status</span>
          <span>Last checked</span>
        </div>
        <div class="table-body" id="table-body">
        </div>
        <div class="empty-state" id="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 14L14 4L24 14L14 24L4 14Z"/>
          </svg>
          <h3>No products tracked yet</h3>
          <p>Start by analyzing a product to see it here.</p>
          <a href="/try" class="cta-btn">Analyze a product</a>
        </div>
      </div>
    </div>
  </main>

  <script>
    function renderDashboard() {
      const tracked = JSON.parse(localStorage.getItem('talon_tracked') || '[]') as Array<{
        url: string;
        status: string;
        timestamp: string;
      }>;

      const tableBody = document.getElementById('table-body') as HTMLElement;
      const emptyState = document.getElementById('empty-state') as HTMLElement;

      if (tracked.length === 0) {
        tableBody.style.display = 'none';
        emptyState.style.display = 'block';
        return;
      }

      tableBody.style.display = 'block';
      emptyState.style.display = 'none';

      tableBody.innerHTML = tracked.map(item => {
        const statusColors: Record<string, string> = {
          overpriced: '#ef4444',
          underpriced: '#10b981',
          competitive: '#06b6d4'
        };
        const statusLabels: Record<string, string> = {
          overpriced: 'Overpriced',
          underpriced: 'Underpriced',
          competitive: 'Competitive'
        };
        const color = statusColors[item.status] || '#94a3b8';
        const label = statusLabels[item.status] || item.status;

        let hostname = item.url;
        try {
          hostname = new URL(item.url).hostname + new URL(item.url).pathname;
          if (hostname.length > 40) {
            hostname = hostname.slice(0, 37) + '...';
          }
        } catch {}

        const date = new Date(item.timestamp);
        const timeAgo = formatTimeAgo(date);

        return `
          <div class="table-row">
            <span class="product-url">${hostname}</span>
            <span class="status-badge" style="color: ${color}; background: ${color}15;">${label}</span>
            <span class="last-checked">${timeAgo}</span>
          </div>
        `;
      }).join('');
    }

    function formatTimeAgo(date: Date): string {
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'Just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;

      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    document.addEventListener('DOMContentLoaded', renderDashboard);
  </script>

  <style>
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      background: rgba(10, 14, 39, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 1.1rem;
      color: #f1f5f9;
      text-decoration: none;
    }

    .logo span {
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-link {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .nav-link:hover {
      color: #f1f5f9;
    }

    .btn-primary {
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      color: #fff;
      text-decoration: none;
      padding: 0.6rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.2s;
    }

    .btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .dashboard-page {
      min-height: 100vh;
      padding: 8rem 2rem 4rem;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .page-header h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #f1f5f9;
    }

    .analyze-link {
      color: #06b6d4;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .analyze-link:hover {
      color: #0891b2;
    }

    .dashboard-table {
      background: rgba(13, 17, 23, 0.8);
      border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 16px;
      overflow: hidden;
    }

    .table-header {
      display: grid;
      grid-template-columns: 1fr 120px 120px;
      gap: 1rem;
      padding: 1rem 1.5rem;
      background: rgba(10, 14, 39, 0.5);
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
      font-size: 0.75rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .table-body {
      display: flex;
      flex-direction: column;
    }

    .table-row {
      display: grid;
      grid-template-columns: 1fr 120px 120px;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(148, 163, 184, 0.06);
      align-items: center;
      transition: background 0.2s;
    }

    .table-row:last-child {
      border-bottom: none;
    }

    .table-row:hover {
      background: rgba(10, 14, 39, 0.3);
    }

    .product-url {
      color: #f1f5f9;
      font-size: 0.9rem;
      font-family: 'Space Mono', monospace;
    }

    .status-badge {
      padding: 0.375rem 0.75rem;
      border-radius: 100px;
      font-size: 0.75rem;
      font-weight: 600;
      text-align: center;
    }

    .last-checked {
      color: #64748b;
      font-size: 0.85rem;
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: 4rem 2rem;
      color: #64748b;
    }

    .empty-state svg {
      opacity: 0.3;
      margin-bottom: 1rem;
    }

    .empty-state h3 {
      color: #f1f5f9;
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .empty-state p {
      margin-bottom: 1.5rem;
    }

    .cta-btn {
      display: inline-block;
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      color: #fff;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .cta-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 25px rgba(6, 182, 212, 0.35);
    }

    @media (max-width: 640px) {
      .dashboard-page {
        padding: 7rem 1rem 3rem;
      }

      .page-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
      }

      .table-header {
        display: none;
      }

      .table-row {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }
    }
  </style>
</Layout>