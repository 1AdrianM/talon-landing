---
import Layout from '../layouts/Layout.astro';
import SeoPage from '../components/SeoPage.astro';

const pageTitle = "Yeezy 350 Price Tracker — Real-Time Competitor Monitoring";
const pageDescription = "Track Yeezy 350 prices across StockX, GOAT, eBay, and Amazon. Get alerts when prices change and never miss a selling opportunity.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <SeoPage
    title={pageTitle}
    description={pageDescription}
    slug="yeezy-350-price-tracker"
    heroEyebrow="Price Check"
    heroHeadline="Is your price competitive?"
    heroSubheadline="Paste a product URL and get a clear verdict: raise, drop, or hold."
    ctaPrimary="Check my price"
  />
</Layout>