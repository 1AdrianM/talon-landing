---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Buy Box Tracker — Talon" noindex={true} description="Talon price check tool for Shopify sellers.">
  <div style="min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:40px;text-align:center;font-family:var(--sans)">
    <p style="font-family:var(--mono);font-size:11px;color:var(--hold)">Page moved</p>
    <h1 style="font-family:var(--display);font-size:28px;font-weight:700;color:var(--ink)">Check your price on the home page</h1>
    <a href="/" style="padding:12px 24px;background:var(--ink);color:var(--surface);border-radius:var(--radius);font-size:14px;font-weight:600;text-decoration:none">Go to home →</a>
  </div>
</Layout>
