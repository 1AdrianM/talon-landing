---
import Layout from '../layouts/Layout.astro';
import SeoPage from '../components/SeoPage.astro';

const pageTitle = "Air Force 1 Price Comparison — Track Nike Competitors";
const pageDescription = "See how your Air Force 1 pricing compares to competitors. Detect price drops, position changes, and get recommendations to stop losing sales.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <SeoPage
    title={pageTitle}
    description={pageDescription}
    slug="air-force-1-price-comparison"
    heroEyebrow="Price Comparison"
    heroHeadline="Is your price competitive?"
    heroSubheadline="Paste a product URL and get a clear verdict: raise, drop, or hold."
    ctaPrimary="Check my price"
  />
</Layout>