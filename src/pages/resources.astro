---
import Layout from '../layouts/Layout.astro';
import TalonLogo from '../components/TalonLogo.astro';

const posts = [
  {
    title: "How to Monitor Your Shopify Competitors (2026 Guide)",
    description: "A practical guide to tracking rival stores, reacting to price changes in real time, and protecting your sales margin.",
    category: "Shopify",
    slug: "shopify-competitor-monitoring-guide",
    readTime: "5 min"
  },
  {
    title: "Best Shopify Competitor Price Monitoring Tools (2026)",
    description: "Talon, Prisync, Price2Spy, Minderest, and Competera reviewed — judged on reaction speed and quality of output.",
    category: "Tools",
    slug: "best-shopify-competitor-price-monitoring-tools",
    readTime: "6 min"
  },
  {
    title: "What Is Repricing in eCommerce? (And Why Most Sellers Do It Wrong)",
    description: "Learn what repricing actually means and how to move from reactive pricing to intelligent, impact-driven decisions.",
    category: "Strategy",
    slug: "what-is-repricing-ecommerce",
    readTime: "6 min"
  },
  {
    title: "Best Tools to Track Competitor Prices in Real-Time (2026)",
    description: "Compare the best competitor price tracking tools for Shopify and WooCommerce sellers on reaction speed and actionable output.",
    category: "Tools",
    slug: "best-competitor-price-tracking-tools",
    readTime: "7 min"
  },
  {
    title: "Why Your Products Aren't Selling: The Pricing Diagnosis Guide",
    description: "Find out why your products aren't converting — pricing gaps, competitor moves, and what to do about each one.",
    category: "Diagnosis",
    slug: "why-your-products-arent-selling",
    readTime: "5 min"
  }
];
---

<Layout
  title="Resources — Talon"
  description="Guides and tools to help Shopify store owners price smarter. Competitor monitoring, repricing strategy, and decision frameworks."
>
  <nav class="topnav">
    <a href="/" class="nav-logo">
      <TalonLogo size={24} />
      <span class="logo-name">Talon</span>
    </a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/resources" class="nav-link active" aria-current="page">Resources</a>
    </div>
    <a href="/#early-access" class="nav-cta">Get early access →</a>
  </nav>

  <header class="page-header">
    <p class="page-tag">Resources</p>
    <h1>Pricing guides for Shopify sellers</h1>
    <p class="page-intro">Practical frameworks for competitive pricing decisions — no dashboards, no data science required.</p>
  </header>

  <section class="posts-section">
    <div class="posts-grid">
      {posts.map((post) => (
        <a href={`/${post.slug}`} class="post-card">
          <div class="post-content">
            <div class="post-meta-top">
              <span class="post-category">{post.category}</span>
              <span class="post-readtime">{post.readTime} read</span>
            </div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-description">{post.description}</p>
            <span class="post-cta">Read article →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <p class="cta-tag">Free tool</p>
      <h2>See where your price stands right now</h2>
      <p class="cta-sub">Paste any Shopify product URL. Get a verdict in seconds — no signup.</p>
      <a href="/#tool" class="btn-primary">Check my price →</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-brand">
      <TalonLogo size={20} />
      <span>Talon</span>
    </div>
    <span class="footer-tagline">Pricing Decision Engine · Early access</span>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="mailto:hello@trytalon.com">Contact</a>
    </div>
  </footer>
</Layout>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.topnav {
  height: 54px; display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px; border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 100;
  background: rgba(251,247,240,0.92); backdrop-filter: blur(12px);
}
.nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
.logo-name { font-family: var(--display); font-size: 16px; font-weight: 700; color: var(--ink); }
.nav-links { display: flex; gap: 4px; }
.nav-link { font-size: 13px; color: var(--ink-2); text-decoration: none; padding: 6px 10px; border-radius: 6px; transition: color .15s; }
.nav-link:hover, .nav-link.active { color: var(--ink); }
.nav-cta { font-size: 13px; font-weight: 600; padding: 7px 16px; border-radius: 8px; background: var(--accent); color: var(--accent-ink); text-decoration: none; transition: opacity .15s; }
.nav-cta:hover { opacity: .9; }

.page-header { max-width: 680px; margin: 0 auto; padding: 56px 32px 40px; text-align: center; }
.page-tag { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--hold); margin-bottom: 14px; }
h1 { font-family: var(--display); font-size: clamp(26px, 4vw, 38px); font-weight: 800; letter-spacing: -0.7px; color: var(--ink); margin-bottom: 14px; line-height: 1.15; }
.page-intro { font-size: 16px; color: var(--ink-2); line-height: 1.65; max-width: 480px; margin: 0 auto; }

.posts-section { max-width: 1000px; margin: 0 auto; padding: 0 32px 72px; }
.posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.post-card {
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  text-decoration: none; display: flex; flex-direction: column;
  transition: box-shadow .2s, border-color .2s;
}
.post-card:hover { border-color: var(--ink-2); box-shadow: 0 4px 20px rgba(31,26,23,0.08); }
.post-content { padding: 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
.post-meta-top { display: flex; align-items: center; justify-content: space-between; }
.post-category { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--opp); }
.post-readtime { font-family: var(--mono); font-size: 10px; color: var(--hold); }
.post-title { font-family: var(--display); font-size: 17px; font-weight: 700; color: var(--ink); line-height: 1.3; letter-spacing: -0.2px; }
.post-description { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; flex: 1; }
.post-cta { font-family: var(--mono); font-size: 11px; color: var(--hold); transition: color .15s; }
.post-card:hover .post-cta { color: var(--ink); }

.cta-section { background: var(--hold-bg); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 64px 32px; text-align: center; }
.cta-inner { max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.cta-tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--hold); }
.cta-section h2 { font-family: var(--display); font-size: clamp(20px, 3vw, 26px); font-weight: 700; letter-spacing: -0.4px; color: var(--ink); }
.cta-sub { font-size: 14px; color: var(--ink-2); line-height: 1.6; }
.btn-primary { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; padding: 12px 24px; border-radius: var(--radius); background: var(--ink); color: var(--surface); text-decoration: none; transition: opacity .15s; }
.btn-primary:hover { opacity: .85; }

.footer { border-top: 1px solid var(--line); padding: 22px 32px; display: flex; align-items: center; justify-content: space-between; gap: 20px; background: var(--bg); }
.footer-brand { display: flex; align-items: center; gap: 6px; font-family: var(--display); font-size: 14px; font-weight: 700; color: var(--ink); }
.footer-tagline { font-family: var(--mono); font-size: 11px; color: var(--hold); }
.footer-links { display: flex; gap: 20px; }
.footer-links a { font-family: var(--mono); font-size: 11px; color: var(--hold); text-decoration: none; transition: color .15s; }
.footer-links a:hover { color: var(--ink); }

@media (max-width: 860px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) {
  .posts-grid { grid-template-columns: 1fr; }
  .topnav, .page-header, .posts-section, .cta-section, .footer { padding-left: 20px; padding-right: 20px; }
  .footer { flex-direction: column; gap: 10px; text-align: center; }
  .footer-links { justify-content: center; flex-wrap: wrap; }
  .nav-links { display: none; }
}
</style>
