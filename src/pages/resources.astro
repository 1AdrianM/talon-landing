---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    title: "What Is Repricing in eCommerce? (And Why Most Sellers Do It Wrong)",
    description: "Learn what repricing actually means, why most sellers fail at it, and how to move from reactive pricing to intelligent decisions.",
    category: "Strategy",
    slug: "what-is-repricing-ecommerce",
    readTime: "6 min read",
    image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=400&h=250&fit=crop"
  },
  {
    title: "Best Shopify Competitor Price Monitoring Tools (2026)",
    description: "Compare the best tools for Shopify. Talon, Prisync, Price2Spy, Minderest, and Competera reviewed.",
    category: "Platform",
    slug: "best-shopify-competitor-price-tracking-tools",
    readTime: "6 min read",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=250&fit=crop"
  },
  {
    title: "Best Amazon Price Tracking Tools (2026)",
    description: "Compare the best Amazon price tracking tools. Real-time alerts, Buy Box protection, and actionable insights.",
    category: "Amazon",
    slug: "best-amazon-price-tracking-tools",
    readTime: "6 min read",
    image: "https://images.unsplash.com/photo-1557821552-17105176666c?w=400&h=250&fit=crop"
  },
  {
    title: "Best Tools to Track Competitor Prices (2026)",
    description: "Compare tools for Amazon, Shopify, WooCommerce. Real-time speed and actionable insights compared.",
    category: "Tools",
    slug: "best-competitor-price-tracking-tools",
    readTime: "7 min read",
    image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=400&h=250&fit=crop"
  },
  {
    title: "Amazon Buy Box Strategy: Price Monitoring Guide",
    description: "Learn how to win and keep the Amazon Buy Box. Monitor competitor prices in real time and protect your position.",
    category: "Amazon",
    slug: "amazon-buy-box-strategy",
    readTime: "5 min read",
    image: "https://images.unsplash.com/photo-1523474253046-8cd2748b5fd2?w=400&h=250&fit=crop"
  },
  {
    title: "How to Monitor Your Shopify Competitors (2026 Guide)",
    description: "A practical guide to monitoring your Shopify competitors' prices. React to price changes in real time.",
    category: "Shopify",
    slug: "shopify-competitor-monitoring-guide",
    readTime: "5 min read",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=250&fit=crop"
  },
  {
    title: "Why Your Products Aren't Selling: The Pricing Diagnosis Guide",
    description: "Find out why your products aren't converting. Learn how pricing gaps and competitor moves affect your sales.",
    category: "Diagnosis",
    slug: "why-your-products-arent-selling",
    readTime: "5 min read",
    image: "https://images.unsplash.com/photo-1553729459-efe14ef6055d?w=400&h=250&fit=crop"
  },
  {
    title: "Yeezy 350 Resale: Market Price Tracking Guide",
    description: "Track Yeezy 350 prices across StockX, GOAT, eBay. Learn to time your sales and maximize profit margins.",
    category: "Sneakers",
    slug: "yeezy-350-resale-guide",
    readTime: "5 min read",
    image: "https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?w=400&h=250&fit=crop"
  },
  {
    title: "Air Force 1 Resale: Competitive Pricing Guide",
    description: "Track Nike Air Force 1 prices across Nike.com, Foot Locker, StockX. Monitor competitors and maximize margins.",
    category: "Sneakers",
    slug: "air-force-1-resale-guide",
    readTime: "5 min read",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&h=250&fit=crop"
  }
];
---

<Layout title="Resources — Talon Pricing Intelligence">
<nav>
  <div class="nav-logo">
    <a href="/">
      <img src="/talon-logo.png" alt="Talon" class="nav-logo-img" />
      <span class="logo-name">Talon</span>
    </a>
  </div>
  <div class="nav-right">
    <a href="/" class="nav-link">Home</a>
    <a href="/" class="nav-link active">Resources</a>
    <button class="nav-cta" onclick="document.getElementById('tool').scrollIntoView({behavior:'smooth'})">Try Free →</button>
  </div>
</nav>

<header class="page-header">
  <div class="breadcrumb">Talon / Resources</div>
  <h1>Pricing Intelligence Resources</h1>
  <p class="page-intro">
    Guides, tools, and insights to help you price smarter and compete better.
  </p>
</header>

<section class="posts-section" id="tool">
  <div class="posts-grid">
    {posts.map((post, index) => (
      <a href={`/${post.slug}`} class="post-card">
        <div class="post-image" style={`background-image: url('${post.image}')`}></div>
        <div class="post-content">
          <div class="post-category">{post.category}</div>
          <h2 class="post-title">{post.title}</h2>
          <p class="post-description">{post.description}</p>
          <div class="post-meta">
            <span class="post-readtime">{post.readTime}</span>
            <span class="post-arrow">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<section class="cta-section">
  <h2>Ready to take action?</h2>
  <p>Start analyzing your products and see what your competitors are doing.</p>
  <div class="cta-group">
    <a href="/" class="btn-primary">Analyze Your Product →</a>
    <span class="cta-note">Free · No signup required</span>
  </div>
</section>

<footer>
  <div class="footer-logo">
    <a href="/">
      <img src="/talon-logo.png" alt="Talon" class="footer-logo-img" />
      <span>Talon</span>
    </a>
  </div>
  <span class="footer-tagline">Pricing Intelligence Engine</span>
</footer>

<style>
nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:56px;border-bottom:1px solid var(--border);background:rgba(9,9,11,0.85);backdrop-filter:blur(12px)}
.nav-logo a{display:flex;align-items:center;gap:9px;text-decoration:none}
.nav-logo-img{width:40px;height:40px;object-fit:contain;border-radius:8px}
.logo-name{font-family:var(--display);font-size:16px;font-weight:600;letter-spacing:-0.3px;color:var(--t1)}
.nav-right{display:flex;align-items:center;gap:20px}
.nav-link{color:var(--t2);text-decoration:none;font-size:14px;transition:color .15s}
.nav-link:hover,.nav-link.active{color:var(--t1)}
.nav-cta{font-size:13px;font-weight:500;padding:7px 16px;border-radius:6px;background:var(--t1);color:var(--bg0);border:none;cursor:pointer}

.page-header{max-width:860px;margin:0 auto;padding:80px 40px 60px;text-align:center}
.breadcrumb{font-family:var(--mono);font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}
.page-header h1{font-family:var(--display);font-size:clamp(32px,5vw,48px);font-weight:800;letter-spacing:-1px;line-height:1.15;color:var(--t1);margin-bottom:16px}
.page-intro{font-size:18px;color:var(--t2);max-width:520px;margin:0 auto;line-height:1.6}

.posts-section{padding:0 40px 80px;max-width:1100px;margin:0 auto}
.posts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}

.post-card{background:var(--bg1);border:1px solid var(--border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;transition:transform .2s,border-color .2s}
.post-card:hover{transform:translateY(-4px);border-color:var(--border-hi)}
.post-image{width:100%;height:160px;background-size:cover;background-position:center;background-color:var(--bg2)}
.post-content{padding:24px;display:flex;flex-direction:column;flex:1}
.post-category{font-family:var(--mono);font-size:10px;color:var(--grn);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}
.post-title{font-family:var(--display);font-size:20px;font-weight:700;color:var(--t1);line-height:1.3;margin-bottom:12px}
.post-description{font-size:14px;color:var(--t2);line-height:1.6;flex:1;margin-bottom:14px}
.post-meta{display:flex;align-items:center;justify-content:space-between}
.post-readtime{font-family:var(--mono);font-size:11px;color:var(--t3)}
.post-arrow{font-size:18px;color:var(--t2);transition:transform .2s}
.post-card:hover .post-arrow{transform:translateX(4px);color:var(--t1)}

.cta-section{background:var(--bg1);border-top:1px solid var(--border);padding:80px 40px;text-align:center}
.cta-section h2{font-family:var(--display);font-size:28px;font-weight:700;color:var(--t1);margin-bottom:12px}
.cta-section p{font-size:16px;color:var(--t2);margin-bottom:24px}
.cta-group{display:flex;flex-direction:column;align-items:center;gap:12px}
.btn-primary{display:inline-flex;align-items:center;gap:8px;font-size:15px;font-weight:600;padding:14px 28px;border-radius:var(--radius);background:var(--t1);color:var(--bg0);border:none;cursor:pointer;text-decoration:none}
.btn-primary:hover{opacity:0.88}
.cta-note{font-family:var(--mono);font-size:11px;color:var(--t3)}

footer{border-top:1px solid var(--border);padding:24px 40px;display:flex;align-items:center;justify-content:space-between}
.footer-logo a{display:flex;align-items:center;gap:8px;text-decoration:none}
.footer-logo-img{width:32px;height:32px;object-fit:contain;border-radius:6px}
.footer-logo{font-family:var(--display);font-size:14px;font-weight:600;color:var(--t1)}
.footer-tagline{font-family:var(--mono);font-size:11px;color:var(--t3)}

@media (max-width: 900px) {
  .posts-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .posts-grid { grid-template-columns: 1fr; }
  nav,.page-header,.posts-section,.cta-section,footer { padding-left: 20px; padding-right: 20px; }
}
</style>

<style is:global>
:root{
  --bg0:#09090B;--bg1:#0F0F12;--bg2:#16161A;--bg3:#1C1C21;--bg4:#242429;
  --border:rgba(255,255,255,0.05);--border-md:rgba(255,255,255,0.09);--border-hi:rgba(255,255,255,0.14);
  --t1:#EDECEA;--t2:#72727A;--t3:#3F3F46;
  --grn:#1A9E68;
  --sans:'Instrument Sans',system-ui,sans-serif;
  --mono:'DM Mono','Courier New',monospace;
  --display:'Syne',sans-serif;
  --radius:8px;
}
html{scroll-behavior:smooth}
body{background:var(--bg0);color:var(--t1);font-family:var(--sans);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
</style>