---
import Layout from '../layouts/Layout.astro';
import SeoPage from '../components/SeoPage.astro';

const pageTitle = "Amazon Price Tracker for Sellers — Competitor Monitoring";
const pageDescription = "Track Amazon competitor prices in real-time. Get alerts when sellers change prices and never lose the Buy Box again.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <SeoPage
    title={pageTitle}
    description={pageDescription}
    slug="amazon-price-tracker"
    heroEyebrow="Price Check"
    heroHeadline="Is your price competitive?"
    heroSubheadline="Paste a product URL and get a clear verdict: raise, drop, or hold."
    ctaPrimary="Check my price"
  />
</Layout>