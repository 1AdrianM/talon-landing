---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Try Talon - Pricing Decision Tool">
  <nav>
    <div class="container">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path d="M4 14L14 4L24 14L14 24L4 14Z" fill="url(#grad)" />
          <path d="M9 14L14 9L19 14L14 19L9 14Z" fill="#0a0e27" />
          <defs>
            <linearGradient id="grad" x1="4" y1="4" x2="24" y2="24">
              <stop stop-color="#06b6d4" />
              <stop offset="1" stop-color="#7c3aed" />
            </linearGradient>
          </defs>
        </svg>
        <span>TALON</span>
      </a>
      <div class="nav-right">
        <a href="/" class="nav-link">Home</a>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="https://rapidapi.com/1AdrianM/api/price-tracking-api" target="_blank" class="btn-primary">Get API Key</a>
      </div>
    </div>
  </nav>

  <main class="try-page">
    <div class="container">
      <section class="hero">
        <h1>Are you losing sales because of your pricing?</h1>
        <p class="subtitle">Paste your product URL and instantly see how you compare to competitors</p>
      </section>

      <section class="value-preview">
        <div class="value-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>See if you're overpriced or underpriced</span>
        </div>
        <div class="value-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Compare with competitors</span>
        </div>
        <div class="value-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Get a clear recommendation</span>
        </div>
      </section>

      <section class="main-form">
        <div class="form-card">
          <div class="input-wrapper">
            <input
              type="url"
              id="product-url"
              placeholder="Paste your product URL here (Shopify, Amazon, etc.)"
              autocomplete="off"
            />
          </div>

          <div class="competitors-toggle">
            <button type="button" class="toggle-btn" id="toggle-competitors">
              <span>+ Add competitor URLs (optional)</span>
              <svg class="toggle-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>
            <div class="competitors-fields" id="competitors-fields">
              <input type="url" id="competitor-1" placeholder="Competitor URL 1" autocomplete="off" />
              <input type="url" id="competitor-2" placeholder="Competitor URL 2" autocomplete="off" />
              <input type="url" id="competitor-3" placeholder="Competitor URL 3" autocomplete="off" />
            </div>
          </div>

          <button type="button" class="check-btn" id="check-btn">
            <span class="btn-text">Check my price</span>
            <span class="btn-arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </button>

          <div class="loading-state" id="loading-state">
            <div class="loading-steps">
              <div class="loading-step" id="step-1">
                <span class="step-check">✓</span>
                <span class="step-text">Extracting price</span>
              </div>
              <div class="loading-step" id="step-2">
                <span class="step-check">✓</span>
                <span class="step-text">Comparing competitors</span>
              </div>
              <div class="loading-step" id="step-3">
                <span class="step-check">✓</span>
                <span class="step-text">Generating recommendation</span>
              </div>
            </div>
          </div>

          <p class="microcopy">No signup required • Instant results • Works on most stores</p>
        </div>
      </section>

      <section class="examples">
        <h3 class="examples-title">Try with an example</h3>
        <div class="example-cards">
          <button class="example-card" data-url="https://www.amazon.com/dp/B09VJXK2L7">
            <span class="example-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 14L14 4L24 14L14 24L4 14Z"/>
              </svg>
            </span>
            <span class="example-label">Amazon Product</span>
            <span class="example-action">Try this →</span>
          </button>
          <button class="example-card" data-url="https://www.bestbuy.com/site/apple-airpods-pro-2nd-generation/xyz123">
            <span class="example-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 14L14 4L24 14L14 24L4 14Z"/>
              </svg>
            </span>
            <span class="example-label">BestBuy Product</span>
            <span class="example-action">Try this →</span>
          </button>
          <button class="example-card" data-url="https://shop.mystore.com/products/premium-widget">
            <span class="example-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 14L14 4L24 14L14 24L4 14Z"/>
              </svg>
            </span>
            <span class="example-label">Shopify Store Product</span>
            <span class="example-action">Try this →</span>
          </button>
        </div>
      </section>

      <section class="result-section" id="result-section">
        <div class="result-card" id="result-card"></div>
      </section>
    </div>
  </main>

  <script>
    const urlInput = document.getElementById('product-url') as HTMLInputElement;
    const checkBtn = document.getElementById('check-btn') as HTMLButtonElement;
    const loadingState = document.getElementById('loading-state') as HTMLElement;
    const toggleCompetitorsBtn = document.getElementById('toggle-competitors') as HTMLButtonElement;
    const competitorsFields = document.getElementById('competitors-fields') as HTMLElement;
    const resultSection = document.getElementById('result-section') as HTMLElement;
    const resultCard = document.getElementById('result-card') as HTMLElement;

    let competitorsVisible = false;
    let isLoading = false;

    toggleCompetitorsBtn?.addEventListener('click', () => {
      competitorsVisible = !competitorsVisible;
      competitorsFields.classList.toggle('visible', competitorsVisible);
      const arrow = (toggleCompetitorsBtn.querySelector('.toggle-arrow') as any);
      if (arrow) arrow.style.transform = competitorsVisible ? 'rotate(180deg)' : '';
    });

    document.querySelectorAll('.example-card').forEach(card => {
      card.addEventListener('click', () => {
        const url = (card as HTMLElement).dataset.url || '';
        urlInput.value = url;
        urlInput.focus();
        urlInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    checkBtn?.addEventListener('click', async () => {
      const url = urlInput.value.trim();
      if (!url || isLoading) return;

      const competitorInputs = [
        document.getElementById('competitor-1') as HTMLInputElement,
        document.getElementById('competitor-2') as HTMLInputElement,
        document.getElementById('competitor-3') as HTMLInputElement
      ];
      const competitors = competitorInputs
        .map(input => input?.value?.trim())
        .filter(Boolean);

      isLoading = true;
      setLoading(true);
      startLoadingAnimation();

      try {
        const response = await fetch('/api/analyze', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productUrl: url, competitors })
        });

        const data = await response.json();
        renderResult(data);
      } catch {
        renderError();
      } finally {
        isLoading = false;
      }
    });

    function setLoading(loading: boolean) {
      if (loading) {
        checkBtn.classList.add('loading');
        checkBtn.disabled = true;
        loadingState.style.display = 'block';
      } else {
        checkBtn.classList.remove('loading');
        checkBtn.disabled = false;
        loadingState.style.display = 'none';
        resetLoadingSteps();
      }
    }

    function startLoadingAnimation() {
      const steps = ['step-1', 'step-2', 'step-3'];
      steps.forEach((stepId, i) => {
        setTimeout(() => {
          document.getElementById(stepId)?.classList.add('active');
        }, (i + 1) * 600);
      });
    }

    function resetLoadingSteps() {
      ['step-1', 'step-2', 'step-3'].forEach(stepId => {
        document.getElementById(stepId)?.classList.remove('active');
      });
    }

    function renderResult(data: any) {
      resultSection.style.display = 'block';
      resultCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      const statusColors: Record<string, string> = {
        overpriced: '#ef4444',
        underpriced: '#10b981',
        competitive: '#06b6d4'
      };
      const statusLabels: Record<string, string> = {
        overpriced: 'You are overpriced',
        underpriced: 'You are underpriced',
        competitive: 'Competitively priced'
      };
      const statusBg: Record<string, string> = {
        overpriced: 'rgba(239, 68, 68, 0.08)',
        underpriced: 'rgba(16, 185, 129, 0.08)',
        competitive: 'rgba(6, 182, 212, 0.08)'
      };

      const color = statusColors[data.status] || '#06b6d4';
      const label = statusLabels[data.status] || data.status;
      const bg = statusBg[data.status] || 'rgba(6, 182, 212, 0.08)';

      const trendLabels: Record<string, string> = {
        lowering: 'Competitors are lowering prices',
        stable: 'Prices are stable',
        rising: 'Competitors are increasing prices'
      };

      let competitorHtml = '';
      if (data.competitorPrices && Object.keys(data.competitorPrices).length > 0) {
        const competitorList = Object.entries(data.competitorPrices as Record<string, number>)
          .map(([name, price]) => `<div class="competitor-item"><span>${name}</span><span>$${price.toFixed(2)}</span></div>`)
          .join('');
        competitorHtml = `
          <div class="result-block">
            <h4>Compared to ${Object.keys(data.competitorPrices).length} competitors</h4>
            <div class="competitor-list">${competitorList}</div>
          </div>
        `;
      }

      resultCard.innerHTML = `
        <div class="result-header" style="background: ${bg}; border-color: ${color}30;">
          <div class="result-status" style="color: ${color};">${label}</div>
          <div class="result-detail">${data.explanation}</div>
        </div>

        <div class="result-metrics">
          <div class="metric">
            <span class="metric-label">Your price</span>
            <span class="metric-value">$${data.yourPrice.toFixed(2)}</span>
          </div>
          <div class="metric">
            <span class="metric-label">Recommended</span>
            <span class="metric-value recommended">$${data.recommendedPrice.toFixed(2)}</span>
          </div>
          <div class="metric">
            <span class="metric-label">Price range</span>
            <span class="metric-value">$${data.priceRange.min.toFixed(2)} – $${data.priceRange.max.toFixed(2)}</span>
          </div>
        </div>

        <div class="result-confidence">
          <div class="confidence-header">
            <span>Confidence score</span>
            <span style="color: ${color};">${Math.round(data.confidence * 100)}%</span>
          </div>
          <div class="confidence-bar">
            <div class="confidence-fill" style="width: ${Math.round(data.confidence * 100)}%; background: ${color};"></div>
          </div>
        </div>

        <div class="result-trend">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            ${data.trend === 'lowering' ? '<path d="M12 5v14M5 12l7 7 7-7"/>' :
              data.trend === 'rising' ? '<path d="M12 19V5M5 12l7-7 7 7"/>' :
              '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="12" y1="16" x2="12.01" y2="16"/>'}
          </svg>
          <span>${trendLabels[data.trend]}</span>
        </div>

        <div class="result-block">
          <h4>What this means</h4>
          <p>${data.consequence}</p>
        </div>

        <div class="result-block">
          <h4>Recommended action</h4>
          <p>${data.recommendation}</p>
        </div>

        ${competitorHtml}

        <div class="result-cta">
          <button class="cta-primary" id="track-product-btn">Track this product</button>
          <button class="cta-secondary" id="analyze-another-btn">Analyze another product</button>
        </div>
      `;

      setLoading(false);

      document.getElementById('analyze-another-btn')?.addEventListener('click', () => {
        resultSection.style.display = 'none';
        urlInput.value = '';
        urlInput.focus();
      });

      document.getElementById('track-product-btn')?.addEventListener('click', () => {
        const url = urlInput.value.trim();
        if (url) {
          const tracked = JSON.parse(localStorage.getItem('talon_tracked') || '[]');
          tracked.unshift({ url, status: data.status, timestamp: new Date().toISOString() });
          localStorage.setItem('talon_tracked', JSON.stringify(tracked.slice(0, 20)));
          window.location.href = '/dashboard';
        }
      });
    }

    function renderError() {
      setLoading(false);
      resultSection.style.display = 'block';
      resultCard.innerHTML = `
        <div class="result-error">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <h3>We couldn't confidently detect the price</h3>
          <p>This sometimes happens with complex pages.</p>
          <div class="error-actions">
            <a href="/try" class="btn-secondary">Try another product</a>
          </div>
        </div>
      `;
    }
  </script>

  <style>
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      background: rgba(10, 14, 39, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
    }

    nav .container {
      max-width: 1100px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 1.1rem;
      color: #f1f5f9;
      text-decoration: none;
    }

    .logo span {
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-link {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .nav-link:hover {
      color: #f1f5f9;
    }

    .btn-primary {
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      color: #fff;
      text-decoration: none;
      padding: 0.6rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.2s;
    }

    .btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .try-page {
      min-height: 100vh;
      padding: 7rem 2rem 4rem;
    }

    .hero {
      text-align: center;
      margin-bottom: 2rem;
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      color: #f1f5f9;
      line-height: 1.2;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1.15rem;
      color: #94a3b8;
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .value-preview {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
    }

    .value-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #10b981;
      font-size: 0.95rem;
    }

    .value-item svg {
      flex-shrink: 0;
    }

    .main-form {
      margin-bottom: 2.5rem;
    }

    .form-card {
      background: rgba(13, 17, 23, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 24px;
      padding: 2rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .input-wrapper {
      margin-bottom: 1rem;
    }

    .input-wrapper input {
      width: 100%;
      height: 64px;
      background: rgba(10, 14, 39, 0.7);
      border: 2px solid rgba(148, 163, 184, 0.1);
      border-radius: 16px;
      padding: 0 1.5rem;
      color: #f1f5f9;
      font-size: 1.05rem;
      box-sizing: border-box;
      transition: all 0.2s ease;
    }

    .input-wrapper input:focus {
      outline: none;
      border-color: #06b6d4;
      box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.15), 0 0 30px rgba(6, 182, 212, 0.1);
    }

    .input-wrapper input::placeholder {
      color: #475569;
    }

    .toggle-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      background: none;
      border: none;
      color: #06b6d4;
      font-size: 0.9rem;
      padding: 0.75rem 0;
      cursor: pointer;
      transition: color 0.2s;
    }

    .toggle-btn:hover {
      color: #0891b2;
    }

    .toggle-arrow {
      transition: transform 0.2s;
    }

    .competitors-fields {
      display: none;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .competitors-fields.visible {
      display: flex;
    }

    .competitors-fields input {
      width: 100%;
      height: 52px;
      background: rgba(10, 14, 39, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.12);
      border-radius: 12px;
      padding: 0 1rem;
      color: #f1f5f9;
      font-size: 0.9rem;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }

    .competitors-fields input:focus {
      outline: none;
      border-color: #06b6d4;
    }

    .competitors-fields input::placeholder {
      color: #475569;
    }

    .check-btn {
      width: 100%;
      height: 60px;
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      color: #fff;
      border: none;
      border-radius: 14px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .check-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 35px rgba(6, 182, 212, 0.4);
    }

    .check-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    .btn-arrow {
      display: flex;
      align-items: center;
      transition: transform 0.2s;
    }

    .check-btn:hover:not(:disabled) .btn-arrow {
      transform: translateX(4px);
    }

    .loading-state {
      display: none;
      margin-top: 1.5rem;
      padding: 1.5rem;
      background: rgba(10, 14, 39, 0.5);
      border-radius: 12px;
    }

    .loading-step {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      opacity: 0.3;
      transition: opacity 0.3s ease;
    }

    .loading-step.active {
      opacity: 1;
    }

    .loading-step.active .step-check {
      color: #10b981;
    }

    .step-check {
      font-size: 0.9rem;
      font-weight: 700;
      color: #475569;
      transition: color 0.3s ease;
    }

    .step-text {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .microcopy {
      text-align: center;
      color: #64748b;
      font-size: 0.8rem;
      margin-top: 1rem;
    }

    .examples {
      margin-bottom: 2rem;
    }

    .examples-title {
      text-align: center;
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .example-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .example-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1.25rem 1rem;
      background: rgba(13, 17, 23, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.08);
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .example-card:hover {
      border-color: rgba(6, 182, 212, 0.3);
      background: rgba(13, 17, 23, 0.9);
      transform: translateY(-2px);
    }

    .example-icon {
      width: 40px;
      height: 40px;
      background: rgba(6, 182, 212, 0.1);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #06b6d4;
      margin-bottom: 0.25rem;
    }

    .example-label {
      font-size: 0.85rem;
      color: #f1f5f9;
      font-weight: 500;
    }

    .example-action {
      font-size: 0.8rem;
      color: #06b6d4;
      font-weight: 500;
    }

    .result-section {
      display: none;
    }

    .result-card {
      background: rgba(13, 17, 23, 0.95);
      border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 20px;
      padding: 2rem;
      animation: cardEnter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes cardEnter {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .result-header {
      padding: 1.5rem;
      border-radius: 14px;
      border: 2px solid;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .result-status {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .result-detail {
      font-size: 0.95rem;
      color: #94a3b8;
    }

    .result-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .metric {
      text-align: center;
      padding: 1rem;
      background: rgba(10, 14, 39, 0.5);
      border-radius: 10px;
    }

