---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Talon — Pricing Intelligence Engine. Know exactly why your competitors change prices — and what to do about it." />
    <title>{title}</title>
    <Analytics />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root{
    --bg0:#09090B;--bg1:#0F0F12;--bg2:#16161A;--bg3:#1C1C21;--bg4:#242429;
    --border:rgba(255,255,255,0.05);--border-md:rgba(255,255,255,0.09);--border-hi:rgba(255,255,255,0.14);
    --t1:#EDECEA;--t2:#72727A;--t3:#3F3F46;
    --red:#B83232;--red-lo:rgba(184,50,50,0.11);--red-bd:rgba(184,50,50,0.26);--red-glow:rgba(184,50,50,0.3);
    --grn:#1A9E68;--grn-lo:rgba(26,158,104,0.10);--grn-bd:rgba(26,158,104,0.24);--grn-glow:rgba(26,158,104,0.28);
    --amb:#B87A1B;--amb-lo:rgba(184,122,26,0.11);--amb-bd:rgba(184,122,26,0.26);
    --sans:'Instrument Sans',system-ui,sans-serif;
    --mono:'DM Mono','Courier New',monospace;
    --display:'Syne',sans-serif;
    --radius:8px;
  }
  html{scroll-behavior:smooth}
  body{background:var(--bg0);color:var(--t1);font-family:var(--sans);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
</style>