---
// MiniDashboard - Recent tracked items from localStorage
// Shows last 3-5 tracked products with refresh capability
interface Props {
  // No props - fully client-side rendered
}
---

<div class="mini-dashboard" id="mini-dashboard" style="display: none;">
  <div class="dashboard-header">
    <div class="dashboard-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20v-6M6 20V10M18 20V4"/>
      </svg>
      <h3>Recent Tracks</h3>
    </div>
    <button class="clear-btn" id="clear-history" title="Clear history">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
      </svg>
    </button>
  </div>

  <div class="dashboard-list" id="dashboard-list">
    <!-- Items will be injected here -->
  </div>

  <div class="dashboard-empty" id="dashboard-empty">
    <div class="empty-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4M12 8h.01"/>
      </svg>
    </div>
    <p>No recent tracks</p>
    <span>Try tracking a product above to see it here</span>
  </div>
</div>

<style>
  .mini-dashboard {
    background: rgba(13, 17, 23, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 16px;
    padding: 1.25rem;
    animation: fadeIn 0.4s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .dashboard-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
  }

  .dashboard-title h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #f1f5f9;
  }

  .clear-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 6px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .clear-btn:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .dashboard-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dashboard-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(148, 163, 184, 0.06);
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .dashboard-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(148, 163, 184, 0.1);
  }

  .item-favicon {
    width: 28px;
    height: 28px;
    background: rgba(6, 182, 212, 0.1);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #06b6d4;
    flex-shrink: 0;
  }

  .item-favicon svg {
    width: 14px;
    height: 14px;
  }

  .item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item-url {
    font-size: 0.8rem;
    font-family: 'Space Mono', monospace;
    color: #f1f5f9;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item-meta {
    font-size: 0.7rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .item-change {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .item-change.drop {
    color: #10b981;
  }

  .item-change.increase {
    color: #ef4444;
  }

  .item-change.neutral {
    color: #64748b;
  }

  .item-price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f1f5f9;
    font-family: 'Space Mono', monospace;
    margin-right: 0.5rem;
  }

  .item-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .refresh-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 6px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .refresh-btn:hover {
    color: #06b6d4;
    background: rgba(6, 182, 212, 0.1);
  }

  .refresh-btn.spinning svg {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .remove-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 6px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .remove-btn:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  /* Empty State */
  .dashboard-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1rem;
    color: #64748b;
  }

  .dashboard-empty.show {
    display: flex;
  }

  .dashboard-empty .empty-icon {
    margin-bottom: 0.75rem;
    opacity: 0.5;
  }

  .dashboard-empty p {
    font-size: 0.95rem;
    font-weight: 500;
    color: #94a3b8;
    margin-bottom: 0.25rem;
  }

  .dashboard-empty span {
    font-size: 0.8rem;
    color: #64748b;
  }

  @media (max-width: 640px) {
    .mini-dashboard {
      padding: 1rem;
    }

    .item-price {
      font-size: 0.85rem;
    }
  }
</style>
