---
// InputCard - URL + Selector input form
interface Props {
  prefilledUrl?: string;
  prefilledSelector?: string;
}

const { prefilledUrl = '', prefilledSelector = '.price' } = Astro.props;
---

<div class="input-card" id="input-card">
  <div class="input-header">
    <div class="input-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
    </div>
    <h3>Track a Product</h3>
  </div>

  <div class="input-fields">
    <div class="input-group">
      <label for="product-url">Product URL</label>
      <input
        type="url"
        id="product-url"
        placeholder="https://example.com/product/123"
        value={prefilledUrl}
        autocomplete="off"
      />
      <span class="input-hint">Any public product page</span>
    </div>

    <div class="input-group">
      <label for="selector">CSS Selector</label>
      <input
        type="text"
        id="selector"
        placeholder=".price"
        value={prefilledSelector}
        autocomplete="off"
      />
      <span class="input-hint">HTML element containing the price</span>
    </div>
  </div>

  <button type="button" class="track-btn" id="track-btn">
    <span class="btn-text">Track Price</span>
    <span class="btn-spinner" id="btn-spinner">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/>
      </svg>
    </span>
  </button>

  <div class="quick-tips">
    <span class="tips-label">Quick tip:</span>
    <span class="tips-text">Right-click any price on a page → Inspect → Copy selector</span>
  </div>
</div>

<style>
  .input-card {
    background: rgba(13, 17, 23, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.1);
    border-radius: 16px;
    padding: 1.75rem;
    backdrop-filter: blur(10px);
  }

  .input-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .input-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(124, 58, 237, 0.15));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #06b6d4;
  }

  .input-header h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #f1f5f9;
  }

  .input-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.8rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .input-group input {
    background: rgba(10, 14, 39, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 10px;
    padding: 0.875rem 1rem;
    color: #f1f5f9;
    font-size: 0.9rem;
    font-family: 'Space Mono', monospace;
    transition: all 0.2s ease;
  }

  .input-group input:focus {
    outline: none;
    border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
  }

  .input-group input::placeholder {
    color: #475569;
  }

  .input-hint {
    font-size: 0.75rem;
    color: #64748b;
  }

  .track-btn {
    width: 100%;
    background: linear-gradient(135deg, #06b6d4, #7c3aed);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    position: relative;
    overflow: hidden;
  }

  .track-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 25px rgba(6, 182, 212, 0.35);
  }

  .track-btn:active {
    transform: translateY(0);
  }

  .track-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .track-btn:disabled .btn-text {
    opacity: 0.8;
  }

  .btn-spinner {
    display: none;
    animation: spin 1s linear infinite;
  }

  .track-btn.loading .btn-text {
    opacity: 0.7;
  }

  .track-btn.loading .btn-spinner {
    display: block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .quick-tips {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    font-size: 0.8rem;
  }

  .tips-label {
    color: #06b6d4;
    font-weight: 500;
  }

  .tips-text {
    color: #64748b;
  }

  @media (max-width: 640px) {
    .input-card {
      padding: 1.25rem;
    }
  }
</style>
