---
import TalonLogo from './TalonLogo.astro';
import { AnalyzerHero } from './AnalyzerHero';
---

<!-- ── 1. NAV ── -->
<nav>
  <a href="/" class="nav-logo" aria-label="Talon home">
    <TalonLogo size={28} />
    <span class="nav-logo-name">Talon</span>
  </a>
  <div class="nav-links">
    <a href="#how" class="nav-link">Product</a>
    <a href="#steps" class="nav-link">How it works</a>
    <a href="/resources" class="nav-link">Resources</a>
  </div>
  <a href="#early-access" class="nav-cta">Get early access</a>
</nav>

<!-- ── 2. HERO ── -->
<section class="hero" id="tool">
  <div class="hero-left">
    <div class="hero-eyebrow">Early access: we're onboarding the first stores by hand.</div>
    <h1 class="hero-h1">Is your price right?</h1>
    <p class="hero-sub">
      Paste a product URL from your Shopify store and see where you stand
      against competitors, and what to do next.
    </p>
    <AnalyzerHero client:load />
  </div>

  <div class="hero-right" aria-hidden="true">
    <!-- Example decision cards (labeled, not real data) -->
    <div class="example-feed">
      <div class="ef-header">
        <span class="ef-label">Example · sample data</span>
      </div>

      <div class="ef-card ef-alert">
        <div class="ef-card-head">
          <span class="ef-tag ef-tag-alert">⚠ Alert</span>
          <span class="ef-conf">88% confidence</span>
        </div>
        <p class="ef-title">SneakerHub dropped Court Classic by 12%</p>
        <p class="ef-prices">
          <span class="ef-old">$125</span> → <span class="ef-new-alert">$109</span>
          <span class="ef-note">, still $4 above cheapest of 3</span>
        </p>
        <div class="ef-action">Drop to $109 (if your margin allows)</div>
      </div>

      <div class="ef-card ef-alert">
        <div class="ef-card-head">
          <span class="ef-tag ef-tag-alert">⚠ Alert</span>
          <span class="ef-conf">95% confidence</span>
        </div>
        <p class="ef-title">You're the most expensive for Trail Runner by 18%</p>
        <p class="ef-prices">
          <span class="ef-old">$215</span> → <span class="ef-new-alert">$187</span>
          <span class="ef-note">, back in the pack of 5</span>
        </p>
        <div class="ef-action">Drop to $187 (if your margin allows)</div>
      </div>

      <div class="ef-card ef-opp">
        <div class="ef-card-head">
          <span class="ef-tag ef-tag-opp">↑ Opportunity</span>
          <span class="ef-conf">74% confidence</span>
        </div>
        <p class="ef-title">Two competitors raised prices on Road Max</p>
        <p class="ef-prices">
          <span class="ef-old">$130</span> → <span class="ef-new-opp">$145</span>
          <span class="ef-note">, you'd still be the lowest</span>
        </p>
        <div class="ef-action">Raise to $145</div>
      </div>

      <div class="ef-collapsed">
        <span>2 low-priority: no action needed</span>
        <span class="ef-chevron">›</span>
      </div>
    </div>
  </div>

  <!-- Mobile: single card below the form -->
  <div class="hero-mobile-card" aria-hidden="true">
    <div class="ef-header"><span class="ef-label">Example · sample data</span></div>
    <div class="ef-card ef-alert" style="border-radius:0;border:none;border-bottom:1px solid var(--line)">
      <div class="ef-card-head">
        <span class="ef-tag ef-tag-alert">⚠ Alert</span>
        <span class="ef-conf">88% confidence</span>
      </div>
      <p class="ef-title">SneakerHub dropped Court Classic by 12%</p>
      <p class="ef-prices">
        <span class="ef-old">$125</span> → <span class="ef-new-alert">$109</span>
      </p>
      <div class="ef-action">Drop to $109 (if your margin allows)</div>
    </div>
  </div>
</section>

<!-- ── 3. HOW IT WORKS ── -->
<section class="section" id="steps">
  <div class="section-inner">
    <div class="section-tag">How it works</div>
    <h2 class="section-title">Three steps. One action.</h2>
    <div class="steps-grid">
      <div class="step">
        <span class="step-num">01</span>
        <h3 class="step-title">Paste your product URL</h3>
        <p class="step-desc">Any product page from your Shopify store. No CSS selectors, no setup.</p>
      </div>
      <div class="step">
        <span class="step-num step-num-2">02</span>
        <h3 class="step-title">See your price verdict</h3>
        <p class="step-desc">We check where your price stands against competitors and give you a clear action — not a dashboard.</p>
      </div>
      <div class="step">
        <span class="step-num step-num-3">03</span>
        <h3 class="step-title">Get alerts when it changes <span class="early-badge">early access</span></h3>
        <p class="step-desc">Leave your email and we'll notify you whenever the picture changes. Monitoring is in early access.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── 4. SAMPLE VERDICTS ── -->
<section class="section section-alt" id="how">
  <div class="section-inner">
    <div class="section-tag">What Talon says</div>
    <h2 class="section-title">Three verdicts. All honest.</h2>
    <div class="verdicts-grid">
      <div class="verdict-card verdict-alert">
        <div class="verdict-top">
          <span class="verdict-tag vtag-alert">⚠ You're losing sales</span>
        </div>
        <h3 class="verdict-h">You became the most expensive option</h3>
        <p class="verdict-p">A competitor dropped their price. Customers compare — and leave. Talon catches it and tells you what to do.</p>
        <div class="verdict-action">Drop to match market · suggested price shown</div>
      </div>
      <div class="verdict-card verdict-opp">
        <div class="verdict-top">
          <span class="verdict-tag vtag-opp">↑ Leave money on the table</span>
        </div>
        <h3 class="verdict-h">Competitors raised — you can too</h3>
        <p class="verdict-p">Supply is tight and two competitors already moved up. You're still the cheapest. There's room to raise.</p>
        <div class="verdict-action">Raise price · you'd still be competitive</div>
      </div>
      <div class="verdict-card verdict-hold">
        <div class="verdict-top">
          <span class="verdict-tag vtag-hold">· Hold for now</span>
        </div>
        <h3 class="verdict-h">No action needed</h3>
        <p class="verdict-p">Your price is in the competitive range. Talon confirms you're fine and tells you when that changes.</p>
        <div class="verdict-action">You're set · we'll alert you if it shifts</div>
      </div>
    </div>
  </div>
</section>

<!-- ── 5. DECISIONS, NOT DASHBOARDS ── -->
<section class="section">
  <div class="section-inner">
    <div class="section-tag">Decisions, not dashboards</div>
    <h2 class="section-title">Most tools show you data.<br/><em>Talon tells you what to do with it.</em></h2>
    <div class="comparison">
      <div class="comp-cell comp-other">
        <span class="comp-label">Other tools</span>
        <div class="comp-body">Here's a chart with 14 metrics</div>
      </div>
      <div class="comp-cell comp-talon">
        <span class="comp-label">Talon</span>
        <div class="comp-body">Drop to $187 — you're the most expensive by 18%</div>
      </div>
    </div>
    <div class="feed-preview" aria-label="Example action feed (sample data)">
      <div class="fp-header">
        <span class="fp-title">Action feed</span>
        <span class="fp-badge">Example · sample data</span>
      </div>
      <div class="fp-event fp-alert">
        <div class="fp-dot fp-dot-alert"></div>
        <div class="fp-body">
          <p class="fp-event-title">SneakerHub dropped Court Classic by 12%</p>
          <p class="fp-event-action">▸ Drop to $109 · still $4 above cheapest of 3</p>
        </div>
        <span class="fp-conf">88%</span>
      </div>
      <div class="fp-event fp-opp">
        <div class="fp-dot fp-dot-opp"></div>
        <div class="fp-body">
          <p class="fp-event-title">Two competitors raised prices on Road Max</p>
          <p class="fp-event-action">▸ Raise to $145 · you'd still be the lowest</p>
        </div>
        <span class="fp-conf">74%</span>
      </div>
      <div class="fp-event fp-alert">
        <div class="fp-dot fp-dot-alert"></div>
        <div class="fp-body">
          <p class="fp-event-title">You're the most expensive for Trail Runner by 18%</p>
          <p class="fp-event-action">▸ Drop to $187 · back in the pack of 5</p>
        </div>
        <span class="fp-conf">95%</span>
      </div>
    </div>
  </div>
</section>

<!-- ── 6. PROBLEM ── -->
<section class="problem-section">
  <div class="section-inner problem-inner">
    <p class="problem-p">
      <strong>Most stores don't lose money because of bad pricing.</strong><br/>
      They lose money because they react too late.<br/><br/>
      By the time you notice a competitor dropped their price,<br/>
      you've already lost the sale.
    </p>
    <p class="problem-punch">The sale is gone before you even noticed.</p>
  </div>
</section>

<!-- ── 7. EARLY ACCESS ── -->
<section class="section" id="early-access">
  <div class="section-inner">
    <div class="section-tag">Early access</div>
    <h2 class="section-title">We're onboarding the first stores by hand.</h2>
    <p class="ea-sub">
      The price check is free and needs no signup. Ongoing monitoring and alerts
      are in early access — leave your email and we'll set you up.
    </p>
    <div class="ea-form-wrap">
      <form class="ea-form" id="ea-form" novalidate>
        <label for="ea-email" class="sr-only">Your email address</label>
        <input
          id="ea-email"
          name="email"
          type="email"
          class="ea-input"
          placeholder="you@yourstore.com"
          autocomplete="email"
          aria-required="true"
        />
        <button class="ea-btn" type="submit">Get early access →</button>
      </form>
      <span id="ea-error" class="ea-error" role="alert" aria-live="polite"></span>
      <div id="ea-success" class="ea-success" hidden>
        Got it — you're on the list. We'll be in touch shortly.
      </div>
      <p class="ea-price">Planned price: $19/month. <button class="link-btn" id="ea-survey-toggle">Tell us if that works →</button></p>
    </div>

    <!-- Microsurvey (optional, shown after email or on demand) -->
    <div class="survey" id="ea-survey" hidden>
      <p class="survey-title">Quick questions — 5 optional, takes 30 seconds:</p>
      <div class="survey-q">
        <span class="survey-ql">Which platform?</span>
        <div class="survey-opts" data-q="platform">
          <button class="survey-opt" data-a="shopify">Shopify</button>
          <button class="survey-opt" data-a="woocommerce">WooCommerce</button>
          <button class="survey-opt" data-a="other">Other</button>
        </div>
      </div>
      <div class="survey-q">
        <span class="survey-ql">How many products?</span>
        <div class="survey-opts" data-q="products">
          <button class="survey-opt" data-a="lt10">Less than 10</button>
          <button class="survey-opt" data-a="10-50">10 – 50</button>
          <button class="survey-opt" data-a="gt50">More than 50</button>
        </div>
      </div>
      <div class="survey-q">
        <span class="survey-ql">How do you check prices today?</span>
        <div class="survey-opts" data-q="how_check">
          <button class="survey-opt" data-a="manually">Manually</button>
          <button class="survey-opt" data-a="tool">Use a tool</button>
          <button class="survey-opt" data-a="dont">I don't</button>
        </div>
      </div>
      <div class="survey-q">
        <span class="survey-ql">What do you want first?</span>
        <div class="survey-opts" data-q="want_first">
          <button class="survey-opt" data-a="alert">Price alert when competitors change</button>
          <button class="survey-opt" data-a="suggested">Suggested price to set</button>
          <button class="survey-opt" data-a="auto">Talon applies it for me</button>
        </div>
      </div>
      <div class="survey-q">
        <span class="survey-ql">Where to receive alerts?</span>
        <div class="survey-opts" data-q="channel">
          <button class="survey-opt" data-a="email">Email</button>
          <button class="survey-opt" data-a="slack">Slack</button>
          <button class="survey-opt" data-a="whatsapp">WhatsApp</button>
          <button class="survey-opt" data-a="phone">Phone</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── 8. FAQ ── -->
<section class="faq-section">
  <div class="section-inner">
    <div class="section-tag">FAQ</div>
    <h2 class="section-title" style="margin-bottom:32px">Questions?</h2>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-q" type="button" aria-expanded="false">
          <span>Is this really free?</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" role="region">
          Yes. The price check is free and needs no signup. Ongoing monitoring and alerts are in early access.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-q" type="button" aria-expanded="false">
          <span>How accurate is it?</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" role="region">
          Talon reads public product pages and applies simple, transparent pricing rules. Some stores block automated reading — when that happens we'll tell you instead of guessing.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-q" type="button" aria-expanded="false">
          <span>Which platforms work?</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" role="region">
          Talon works best with Shopify stores. Other sites may work, but it's not guaranteed yet.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-q" type="button" aria-expanded="false">
          <span>How often are prices checked?</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" role="region">
          Right now, when you ask. Continuous monitoring is in early access.
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-q" type="button" aria-expanded="false">
          <span>Is my data secure?</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" role="region">
          We only use the URLs you submit to run your analysis and, if you leave your email, to contact you.
          <!-- TODO: confirm with backend what data is actually stored -->
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── FINAL CTA ── -->
<section class="final-section">
  <div class="section-inner" style="text-align:center">
    <h2 class="final-h2">Try it free. No signup.</h2>
    <p class="final-sub">Paste a URL and see your verdict in seconds.</p>
    <a href="#tool" class="final-btn">Check my price →</a>
    <p class="final-note">No signup required · Free analysis</p>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer>
  <div class="footer-logo">
    <TalonLogo size={22} />
    <span>Talon</span>
  </div>
  <span class="footer-tagline">Pricing Decision Engine · Early access</span>
  <div class="footer-links">
    <a href="/resources">Resources</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href="mailto:hello@trytalon.com">Contact</a>
  </div>
</footer>

<script>
const apiUrl = (import.meta as any).env?.PUBLIC_API_URL ?? 'https://api-talon.fly.dev';

function beacon(name: string, props: Record<string, unknown> = {}) {
  try {
    const utm: Record<string, string> = {};
    new URLSearchParams(location.search).forEach((v, k) => {
      if (k.startsWith('utm_')) utm[k] = v;
    });
    navigator.sendBeacon(
      `${apiUrl}/events`,
      JSON.stringify({ name, props, utm, path: location.pathname }),
    );
  } catch {}
}

document.addEventListener('DOMContentLoaded', () => {
  // FAQ accordion
  document.querySelectorAll<HTMLButtonElement>('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const isOpen = item.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
      (btn.querySelector('.faq-icon') as HTMLElement).textContent = isOpen ? '−' : '+';
    });
  });

  // Early access form
  const eaForm = document.getElementById('ea-form') as HTMLFormElement | null;
  const eaError = document.getElementById('ea-error')!;
  const eaSuccess = document.getElementById('ea-success')!;
  const eaSurveyToggle = document.getElementById('ea-survey-toggle')!;
  const eaSurvey = document.getElementById('ea-survey')!;

  eaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = (eaForm.elements.namedItem('email') as HTMLInputElement);
    const email = emailInput.value.trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRe.test(email)) {
      eaError.textContent = 'Please enter a valid email address';
      emailInput.setAttribute('aria-invalid', 'true');
      return;
    }
    eaError.textContent = '';
    emailInput.removeAttribute('aria-invalid');

    const utm: Record<string, string> = {};
    new URLSearchParams(location.search).forEach((v, k) => { if (k.startsWith('utm_')) utm[k] = v; });

    try {
      await fetch(`${apiUrl}/leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'early_access', utm }),
      });
    } catch {}

    beacon('email_captured', { source: 'early_access' });
    eaForm.hidden = true;
    eaSuccess.hidden = false;
    eaSurvey.hidden = false;
  });

  eaSurveyToggle?.addEventListener('click', () => {
    eaSurvey.hidden = !eaSurvey.hidden;
    beacon('cta_monitoring_click', { action: 'toggle_survey' });
  });

  // Survey
  document.querySelectorAll<HTMLButtonElement>('.survey-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest<HTMLElement>('[data-q]')!;
      const q = group.dataset.q!;
      const a = btn.dataset.a!;
      group.querySelectorAll('.survey-opt').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      beacon('survey_answered', { question: q, answer: a });
    });
  });

  // Intersection observer for appear animations
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.opacity = '1';
          (e.target as HTMLElement).style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll<HTMLElement>('.step, .verdict-card, .faq-item').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(14px)';
      el.style.transition = 'opacity 0.45s ease, transform 0.45s ease';
      observer.observe(el);
    });
  }
});
</script>

<style>
/* No :root — tokens come from tokens.css imported in Layout */

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── NAV ── */
nav {
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px; height: 54px;
  background: rgba(251,247,240,0.92); backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
}
.nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
.nav-logo-name {
  font-family: var(--display); font-size: 16px; font-weight: 700;
  letter-spacing: -0.3px; color: var(--ink);
}
.nav-links { display: flex; align-items: center; gap: 2px; }
.nav-link {
  font-size: 13px; color: var(--ink-2); text-decoration: none;
  padding: 6px 12px; border-radius: 8px; transition: color .15s;
}
.nav-link:hover { color: var(--ink); }
.nav-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.nav-cta {
  font-family: var(--sans); font-size: 13px; font-weight: 600;
  padding: 8px 18px; border-radius: 8px;
  background: var(--accent); color: var(--accent-ink);
  text-decoration: none; transition: opacity .15s, transform .15s;
  letter-spacing: -0.1px;
}
.nav-cta:hover { opacity: .9; transform: translateY(-1px); }
.nav-cta:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

/* ── HERO ── */
.hero {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 48px; align-items: start;
  padding: 72px 64px 96px; max-width: 1280px; margin: 0 auto;
}
.hero-eyebrow {
  font-family: var(--mono); font-size: 11px; color: var(--accent-ink);
  background: var(--accent); display: inline-block;
  padding: 4px 10px; border-radius: 6px; margin-bottom: 24px;
  letter-spacing: 0.2px;
}
.hero-h1 {
  font-family: var(--display); font-size: clamp(38px, 4.5vw, 56px);
  font-weight: 800; letter-spacing: -1.2px; line-height: 1.08;
  color: var(--ink); margin-bottom: 18px;
}
.hero-sub {
  font-size: 16px; color: var(--ink-2); line-height: 1.65;
  margin-bottom: 28px; max-width: 460px;
}
.hero-mobile-card { display: none; }

/* ── EXAMPLE FEED (hero right) ── */
.example-feed {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--radius); overflow: hidden;
  box-shadow: 0 2px 16px rgba(31,26,23,0.06);
}
.ef-header {
  padding: 10px 16px; background: var(--bg);
  border-bottom: 1px solid var(--line);
}
.ef-label {
  font-family: var(--mono); font-size: 10px;
  color: var(--hold); text-transform: uppercase; letter-spacing: 0.8px;
}
.ef-card {
  padding: 14px 16px; border-bottom: 1px solid var(--line);
  border-left: 3px solid transparent;
  display: flex; flex-direction: column; gap: 6px;
}
.ef-alert { border-left-color: var(--alert); }
.ef-opp   { border-left-color: var(--opp); }
.ef-card-head { display: flex; align-items: center; justify-content: space-between; }
.ef-tag {
  font-family: var(--mono); font-size: 10px; font-weight: 500;
  padding: 2px 8px; border-radius: 4px; letter-spacing: 0.3px;
}
.ef-tag-alert { background: var(--alert-bg); color: var(--alert); }
.ef-tag-opp   { background: var(--opp-bg);   color: var(--opp); }
.ef-conf { font-family: var(--mono); font-size: 10px; color: var(--hold); }
.ef-title { font-size: 13px; font-weight: 500; color: var(--ink); line-height: 1.35; }
.ef-prices { font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
.ef-old { text-decoration: line-through; color: var(--hold); }
.ef-new-alert { color: var(--alert); font-weight: 600; }
.ef-new-opp   { color: var(--opp);   font-weight: 600; }
