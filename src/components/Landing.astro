</div>

<section class="section" id="how">
  <div class="section-tag">How it works</div>
  <div class="section-title">Three steps. One action.</div>
  <div class="steps-grid">
    <div class="step">
      <span class="step-num step-num-1">01</span>
      <div class="step-title">Paste your product</div>
