<div class="sticky-bar" id="sticky-bar">
  <span class="sticky-bar-text">Competitors are moving. Your pricing is stale.</span>
  <button class="sticky-bar-btn" onclick="document.getElementById('tool').scrollIntoView({behavior:'smooth'})">Analyze now →</button>
</div>

<script>
function handleSubmit() {
  const input = document.getElementById('product-url');
  const url = input.value.trim();
  if (!url) return false;
  const encoded = encodeURIComponent(url);
  window.location.href = '/analyze?url=' + encoded;
  return false;
}

function toggleFaq(btn) {
  const item = btn.parentElement;
  item.classList.toggle('open');
  btn.querySelector('.faq-icon').textContent = item.classList.contains('open') ? '−' : '+';
}

document.addEventListener('DOMContentLoaded', () => {
  const ssItems = document.querySelectorAll('.ss-item');
  if (ssItems.length > 0) {
    let ssCurrent = 0;
    setInterval(() => {
      ssItems[ssCurrent].classList.remove('ss-active');
      ssCurrent = (ssCurrent + 1) % ssItems.length;
      ssItems[ssCurrent].classList.add('ss-active');
    }, 2000);
  }

  window.addEventListener('scroll', () => {
    document.getElementById('sticky-bar').classList.toggle('show', window.scrollY > 500);
  });

  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting) { e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.step,.what-item,.pillar,.uc-card,.faq-item').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(16px)';
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    observer.observe(el);
  });
});
</script>

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg0:#09090B;--bg1:#0F0F12;--bg2:#16161A;--bg3:#1C1C21;--bg4:#242429;--bg5:#2A2A30;
  --border:rgba(255,255,255,0.055);--border-md:rgba(255,255,255,0.09);--border-hi:rgba(255,255,255,0.16);
  --t1:#EDECEA;--t2:#72727A;--t3:#3F3F46;--t4:#2A2A2E;
  --red:#B83232;--red-lo:rgba(184,50,50,0.12);--red-bd:rgba(184,50,50,0.28);--red-glow:rgba(184,50,50,0.35);--red-txt:#D94040;
  --grn:#1A9E68;--grn-lo:rgba(26,158,104,0.11);--grn-bd:rgba(26,158,104,0.26);--grn-glow:rgba(26,158,104,0.30);--grn-txt:#1DB87A;
  --amb:#B87A1A;--amb-lo:rgba(184,122,26,0.11);--amb-bd:rgba(184,122,26,0.26);--amb-txt:#D4921E;
  --sans:'Instrument Sans',system-ui,sans-serif;
  --mono:'DM Mono','Courier New',monospace;
  --display:'Syne',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg0);color:var(--t1);font-family:var(--sans);font-size:27px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:2px}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes fadeup{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse-dot{0%,100%{opacity:1;box-shadow:0 0 6px var(--grn-glow)}50%{opacity:.6;box-shadow:0 0 12px var(--grn-glow)}}

/* ── NAV ── */
nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 40px;height:52px;border-bottom:1px solid var(--border);background:rgba(9,9,11,0.9);backdrop-filter:blur(16px)}
.nav-logo{display:flex;align-items:center;gap:4px;text-decoration:none}
.nav-logo-mark{width:24px;height:24px;background:var(--t1);border-radius:5px;display:flex;align-items:center;justify-content:center}
.nav-logo-mark svg{width:12px;height:12px}
.nav-logo-name{font-family:var(--display);font-size:27px;font-weight:600;letter-spacing:-0.3px;color:var(--t1)}
.nav-links{display:flex;align-items:center;gap:2px}
.nav-link{font-size:13px;color:var(--t3);text-decoration:none;padding:6px 12px;border-radius:6px;transition:color .15s}
.nav-link:hover{color:var(--t2)}
.nav-cta{font-family:var(--sans);font-size:13px;font-weight:500;padding:7px 16px;border-radius:6px;background:var(--t1);color:var(--bg0);border:none;cursor:pointer;transition:opacity .15s,transform .15s;letter-spacing:-0.1px;text-decoration:none}
.nav-cta:hover{opacity:.88;transform:translateY(-1px)}

/* ── HERO ── */
.hero{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;padding:80px 64px 100px;max-width:1280px;margin:0 auto;position:relative;overflow:hidden;min-height:calc(100vh - 52px)}
.hero::before{content:'';position:absolute;top:-20%;left:-10%;width:60%;height:80%;background:radial-gradient(ellipse at 30% 40%,rgba(184,50,50,0.07) 0%,transparent 65%);pointer-events:none;z-index:0}
.hero-left{display:flex;flex-direction:column;justify-content:center;position:relative;z-index:1;padding-top:20px}
.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;color:var(--red-txt);letter-spacing:0.5px;margin-bottom:28px;text-transform:uppercase}
.hero-eyebrow::before{content:'●';font-size:8px;animation:blink 1.5s infinite}
.hero-h1{font-family:var(--display);font-size:clamp(40px,4.5vw,58px);font-weight:800;letter-spacing:-1.5px;line-height:1.06;color:var(--t1);margin-bottom:20px}
