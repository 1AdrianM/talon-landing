---
import Icon from './Icon.astro';
import TalonLogo from './TalonLogo.astro';
---

<nav>
  <a href="/" class="nav-logo">
    <TalonLogo size={72} class="nav-logo-mark" />
    <span class="nav-logo-name">Talon</span>
  </a>
  <div class="nav-links">
    <a href="#how" class="nav-link">Product</a>
    <a href="#how" class="nav-link">How it works</a>
    <a href="/resources" class="nav-link">Resources</a>
  </div>
  <a href="#tool" class="nav-cta">Analyze your product →</a>
</nav>

<section class="hero" id="tool">
