---
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="/talon-logo.png" alt="Talon" class="logo-img" />
      <span class="logo-text">Talon</span>
    </a>
    <nav class="header-nav">
      <a href="#product" class="nav-link">Product</a>
      <a href="#how" class="nav-link">How it works</a>
      <a href="/resources" class="nav-link">Resources</a>
    </nav>
    <div class="header-right">
      <button class="btn-primary" onclick="document.getElementById('product-url').focus(); document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">
        Analyze your product <span class="arr">→</span>
      </button>
    </div>
  </div>
</header>

<div class="sticky-bar" id="sticky-bar">
  <span>Competitors are moving. Your pricing is stale.</span>
  <button onclick="document.getElementById('product-url').focus(); document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">Analyze now →</button>
</div>

<section class="hero-split">
  <div class="hero-left">
    <div class="hero-eyebrow">Your competitors are adjusting prices right now</div>
    <h1>Stop losing sales to competitor pricing.</h1>
    <p class="hero-sub">Paste your product URL and instantly see pricing gaps, revenue impact, and the exact action to take.</p>

    <div class="analyzer-box" id="analyzer">
      <form class="analyzer-form" onsubmit="return handleSubmit(event)">
        <input 
          type="url" 
          id="product-url" 
          class="analyzer-input" 
          placeholder="https://yourstore.com/product"
          required
        />
        <button type="submit" class="analyzer-btn">Analyze →</button>
      </form>
      <p class="analyzer-note">No signup required · Results in seconds</p>
    </div>
  </div>

  <div class="hero-right">
    <div class="live-feed">
      <div class="feed-header">
        <span class="feed-title">Live Pricing Feed</span>
        <span class="feed-status"><span class="status-dot"></span> Tracking 4 products</span>
      </div>

      <div class="feed-item feed-item-red">
        <div class="feed-time">2 min ago</div>
        <div class="feed-store">NikeStore.com</div>
        <div class="feed-action">Dropped Air Force 1 '07 by 12%</div>
        <div class="feed-impact">Est. impact: <span class="impact-red">-$38/day</span></div>
        <div class="feed-suggestion">
          <span class="sug-label">Talon suggests:</span>
          <span class="sug-action">Match to $109 →</span>
        </div>
        <div class="feed-meta">
          <span class="conf">92% confidence</span>
        </div>
      </div>

      <div class="feed-item feed-item-green">
        <div class="feed-time">8 min ago</div>
        <div class="feed-store">FinishLine</div>
        <div class="feed-action">Raised Jordan 1 by 5%</div>
        <div class="feed-impact">Est. impact: <span class="impact-green">+$22/day</span></div>
        <div class="feed-suggestion">
          <span class="sug-label">Talon suggests:</span>
          <span class="sug-action">Raise to $145 →</span>
        </div>
        <div class="feed-meta">
          <span class="conf">87% confidence</span>
        </div>
      </div>

      <div class="feed-item feed-item-amber">
        <div class="feed-time">14 min ago</div>
        <div class="feed-store">StockX</div>
        <div class="feed-action">Supply squeeze detected - Yeezy 350</div>
        <div class="feed-impact">Market moving upward</div>
        <div class="feed-suggestion">
          <span class="sug-label">Talon suggests:</span>
          <span class="sug-action">Increase stock before price jumps →</span>
        </div>
        <div class="feed-meta">
          <span class="conf">78% confidence</span>
        </div>
      </div>

      <div class="feed-item">
        <div class="feed-time">1 hour ago</div>
        <div class="feed-store">Eastbay</div>
        <div class="feed-action">Added new colorway - Dunk Low</div>
        <div class="feed-impact">No pricing change detected</div>
        <div class="feed-suggestion">
          <span class="sug-label">Status:</span>
          <span class="sug-action" style="color:var(--t3)">Monitoring...</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="stats-row">
  <div class="stat-item">
    <span class="stat-num">2,400+</span>
    <span class="stat-label">Stores analyzed</span>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-num">&lt; 60s</span>
    <span class="stat-label">To first insight</span>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-num">$1.2M</span>
    <span class="stat-label">Revenue protected</span>
  </div>
</section>

<section class="logos-bar">
  <span class="logos-label">Works with</span>
  <div class="logos-track">
    <span>Shopify</span>
    <span>WooCommerce</span>
    <span>BigCommerce</span>
    <span>Magento</span>
  </div>
</section>

<section class="how-it-works" id="how">
  <div class="section-header">
    <span class="section-tag">How it works</span>
    <h2>Three steps. One action.</h2>
  </div>

  <div class="steps-grid">
    <div class="step-card">
      <div class="step-num">01</div>
      <div class="step-title">Paste your product</div>
      <div class="step-desc">Enter any product URL. Talon instantly maps your competitors and starts tracking.</div>
    </div>
    <div class="step-arrow"><Icon name="trending-up" size="20" /></div>
    <div class="step-card">
      <div class="step-num">02</div>
      <div class="step-title">Detect pricing gaps</div>
      <div class="step-desc">See every competitor price change in real time. Know exactly where you stand.</div>
    </div>
    <div class="step-arrow"><Icon name="trending-up" size="20" /></div>
    <div class="step-card">
      <div class="step-num">03</div>
      <div class="step-title">Get live actions</div>
      <div class="step-desc">Receive specific pricing recommendations with estimated revenue impact.</div>
    </div>
  </div>
</section>

<section class="problem-section">
  <div class="problem-block">
    <p>
      <strong>Most stores don't lose money because of bad pricing.</strong><br/>
      They lose money because they react too late.<br/><br/>
      By the time you notice a competitor dropped their price,<br/>
      you've already lost the sale.
    </p>
    <div class="punch">The sale is gone before you even noticed.</div>
  </div>
</section>

<section class="what-section">
  <div class="section-header">
    <span class="section-tag">What Talon does</span>
    <h2>Not just data.<br/><em>Decisions.</em></h2>
    <p class="section-sub">Talon doesn't just track prices. It tells you what changed, why it changed, and what to do — in seconds.</p>
  </div>
  <div class="what-grid">
    <div class="what-item">
      <div class="what-num">01</div>
      <div class="what-title">What changed</div>
      <div class="what-desc">Competitor price movements detected the moment they happen — not hours later.</div>
    </div>
    <div class="what-item">
      <div class="what-num">02</div>
      <div class="what-title">Why it changed</div>
      <div class="what-desc">AI reasons through the signal — sale clearance, supply shock, seasonal shift — and explains it plainly.</div>
    </div>
    <div class="what-item">
      <div class="what-num">03</div>
      <div class="what-title">What to do next</div>
      <div class="what-desc">One clear action with the estimated dollar impact. No dashboards. No spreadsheets. No guessing.</div>
    </div>
  </div>
</section>

<section class="use-cases-section">
  <div class="section-header">
    <span class="section-tag">Use cases</span>
    <h2>Three ways stores <em>bleed money</em><br/>without knowing it.</h2>
  </div>
  <div class="uc-list">
    <div class="uc-card">
      <div class="uc-left">
        <div class="uc-scenario">
          <strong>You're losing sales and don't know why.</strong>
          A competitor drops their price. You don't notice. You lose position. Customers pick them — not you.
        </div>
      </div>
      <div class="uc-right">
        <div class="uc-sug-label">Talon detects</div>
        <div class="signal-row">
          <span class="signal-label">Price drop</span>
          <span class="signal-badge badge-r">−12%</span>
        </div>
        <div class="signal-row">
          <span class="signal-label">Daily impact</span>
          <span class="signal-badge badge-r">−$320 / day</span>
        </div>
        <div class="uc-suggestion">
          <div class="uc-sug-label">Talon suggests</div>
          <div class="uc-sug-action" onclick="document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">Match price to recover lost sales <span>→</span></div>
        </div>
      </div>
    </div>
    <div class="uc-card">
      <div class="uc-left">
        <div class="uc-scenario">
          <strong>You became the most expensive option.</strong>
          Your product is now +18% above the market. Customers compare — and leave. You never saw it happen.
        </div>
      </div>
      <div class="uc-right">
        <div class="uc-sug-label">Talon detects</div>
        <div class="signal-row">
          <span class="signal-label">Market position</span>
          <span class="signal-badge badge-r">#2 → #5</span>
        </div>
        <div class="signal-row">
          <span class="signal-label">Price gap</span>
          <span class="signal-badge badge-r">+18% above market</span>
        </div>
        <div class="uc-suggestion">
          <div class="uc-sug-label">Talon suggests</div>
          <div class="uc-sug-action" onclick="document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">Adjust price to regain competitiveness <span>→</span></div>
        </div>
      </div>
    </div>
    <div class="uc-card">
      <div class="uc-left">
        <div class="uc-scenario">
          <strong>Market shifts — and you leave money on the table.</strong>
          Competitors raise prices. Supply is tight. You stay put. You could have earned more — but you didn't know.
        </div>
      </div>
      <div class="uc-right">
        <div class="uc-sug-label">Talon detects</div>
        <div class="signal-row">
          <span class="signal-label">Market shift</span>
          <span class="signal-badge badge-g">+8% upward</span>
        </div>
        <div class="signal-row">
          <span class="signal-label">Margin opportunity</span>
          <span class="signal-badge badge-g">+12% if you move</span>
        </div>
        <div class="uc-suggestion">
          <div class="uc-sug-label">Talon suggests</div>
          <div class="uc-sug-action" onclick="document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">Increase price while staying competitive <span>→</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="why-section">
  <div class="section-header">
    <span class="section-tag">Why Talon</span>
    <h2>Most tools show you data.<br/><em>Talon tells you what to do with it.</em></h2>
  </div>
  <div class="why-block">
    <div class="why-cell">
      <div class="why-cell-label">Other tools</div>
      <div class="why-cell-title muted">Here's a dashboard with 14 charts</div>
    </div>
    <div class="why-cell">
      <div class="why-cell-label">Talon</div>
      <div class="why-cell-title bright">Drop to $187 — you're losing $510/day</div>
    </div>
  </div>
  <div class="pillars">
    <div class="pillar">
      <div class="pillar-icon"><Icon name="zap" size="18" /></div>
      <div class="pillar-title">Instant analysis</div>
      <div class="pillar-desc">Results in seconds, not after a 3-hour manual review session.</div>
    </div>
    <div class="pillar">
      <div class="pillar-icon"><Icon name="brain" size="18" /></div>
      <div class="pillar-title">Clear reasoning</div>
      <div class="pillar-desc">Plain-language explanations — not just numbers, but the why behind them.</div>
    </div>
    <div class="pillar">
      <div class="pillar-icon"><Icon name="target" size="18" /></div>
      <div class="pillar-title">Direct actions</div>
      <div class="pillar-desc">Built for operators who need to move fast, not analysts building decks.</div>
    </div>
  </div>
</section>

<section class="more-section">
  <div class="more-links">
    <a href="/resources" class="more-link">
      <span class="more-label">Learn more</span>
      <span class="more-title">Resources</span>
      <span class="more-arrow">→</span>
    </a>
    <a href="/docs" class="more-link">
      <span class="more-label">Documentation</span>
      <span class="more-title">How Talon works</span>
      <span class="more-arrow">→</span>
    </a>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <div class="cta-content">
      <span class="cta-tag">Ready?</span>
      <h2>Your competitors are adjusting prices right now.</h2>
      <p>Every minute you wait, you're leaving money on the table. Stop guessing — start tracking.</p>
      <div class="cta-actions">
        <button class="btn-primary btn-lg" onclick="document.getElementById('product-url').focus(); document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">
          Analyze your product →
        </button>
        <span class="cta-note">Free to start · No credit card</span>
      </div>
    </div>
    <div class="cta-visual">
      <div class="cta-card">
        <div class="cta-card-header">
          <span class="cta-card-icon">⚡</span>
          <span class="cta-card-title">Today's Insight</span>
        </div>
        <div class="cta-card-body">
          <div class="cta-stat">
            <span class="cta-stat-num">12</span>
            <span class="cta-stat-label">price changes detected</span>
          </div>
          <div class="cta-stat">
            <span class="cta-stat-num">3</span>
            <span class="cta-stat-label">opportunities found</span>
          </div>
          <div class="cta-stat">
            <span class="cta-stat-num">$847</span>
            <span class="cta-stat-label">potential revenue</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/talon-logo.png" alt="Talon" class="footer-logo" />
      <span>Talon</span>
    </div>
    <span class="footer-tag">Pricing Intelligence for Ecommerce</span>
    <div class="footer-links">
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
      <a href="#">Contact</a>
    </div>
  </div>
</footer>

<script>
function handleSubmit(e) {
  e.preventDefault();
  const input = document.getElementById('product-url');
  const url = input.value.trim();
  if (!url) return false;
  const encoded = encodeURIComponent(url);
  window.location.href = '/analyze?url=' + encoded;
  return false;
}

function toggleFaq(btn) {
  const item = btn.parentElement;
  item.classList.toggle('open');
  const icon = btn.querySelector('.faq-icon');
  icon.textContent = item.classList.contains('open') ? '−' : '+';
}

document.addEventListener('DOMContentLoaded', () => {
  const stickyBar = document.getElementById('sticky-bar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      stickyBar.classList.add('show');
    } else {
      stickyBar.classList.remove('show');
    }
  });
});
</script>

<style>
.site-header{position:sticky;top:0;z-index:100;background:rgba(9,9,11,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.header-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:16px 24px}
.header-logo{display:flex;align-items:center;gap:8px;text-decoration:none}
.logo-img{width:36px;height:36px;object-fit:contain;border-radius:8px}
.logo-text{font-family:var(--display);font-size:18px;font-weight:700;color:var(--t1)}
.header-nav{display:flex;gap:32px}
.nav-link{font-family:var(--sans);font-size:14px;color:var(--t2);text-decoration:none;transition:color .15s}
.nav-link:hover{color:var(--t1)}
.header-right{}
.btn-primary{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;padding:10px 20px;border-radius:8px;background:var(--t1);color:var(--bg0);border:none;cursor:pointer;transition:opacity .15s,transform .15s,box-shadow .15s;white-space:nowrap}
.btn-primary:hover{opacity:0.9;transform:translateY(-1px)}
.btn-primary .arr{transition:transform .15s}
.btn-primary:hover .arr{transform:translateX(3px)}

.sticky-bar{position:fixed;bottom:-60px;left:0;right:0;z-index:99;display:flex;align-items:center;justify-content:center;gap:20px;padding:16px 24px;background:rgba(15,15,18,0.98);border-top:1px solid var(--border);transition:bottom .3s ease;box-shadow:0 -4px 20px rgba(0,0,0,0.4)}
.sticky-bar.show{bottom:0}
.sticky-bar span{font-size:14px;color:var(--t2)}
.sticky-bar button{font-size:13px;font-weight:600;color:var(--t1);background:none;border:none;cursor:pointer;text-decoration:underline}

.hero-split{display:grid;grid-template-columns:1fr 1fr;gap:48px;max-width:1200px;margin:0 auto;padding:80px 24px 60px;align-items:start}
.hero-left{}
.hero-eyebrow{font-family:var(--mono);font-size:12px;color:var(--red);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:16px}
h1{font-family:var(--display);font-size:clamp(32px,4vw,48px);font-weight:800;line-height:1.1;color:var(--t1);margin-bottom:16px;max-width:540px}
.hero-sub{font-size:16px;color:var(--t2);line-height:1.6;margin-bottom:32px;max-width:480px}

.analyzer-box{background:var(--bg2);border:1px solid var(--border-md);border-radius:12px;padding:20px;max-width:480px}
.analyzer-form{display:flex;gap:12px;margin-bottom:10px}
.analyzer-input{flex:1;padding:14px 16px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--t1);font-size:14px;outline:none;transition:border-color .15s}
.analyzer-input::placeholder{color:var(--t3)}
.analyzer-input:focus{border-color:var(--t2)}
.analyzer-btn{padding:14px 24px;background:var(--t1);color:var(--bg0);border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;transition:opacity .15s}
.analyzer-btn:hover{opacity:0.9}
.analyzer-note{font-family:var(--mono);font-size:11px;color:var(--t3)}

.hero-right{}
.live-feed{background:var(--bg1);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.feed-header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;background:var(--bg2);border-bottom:1px solid var(--border)}
.feed-title{font-family:var(--mono);font-size:12px;color:var(--t1);font-weight:500}
.feed-status{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;color:var(--t3)}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--grn);box-shadow:0 0 6px var(--grn-glow)}
.feed-item{padding:16px 18px;border-bottom:1px solid var(--border);transition:background .15s}
.feed-item:last-child{border-bottom:none}
.feed-item:hover{background:var(--bg2)}
.feed-time{font-family:var(--mono);font-size:10px;color:var(--t3);margin-bottom:4px}
.feed-store{font-family:var(--display);font-size:13px;font-weight:600;color:var(--t1);margin-bottom:4px}
.feed-action{font-size:13px;color:var(--t2);margin-bottom:6px}
.feed-impact{font-family:var(--mono);font-size:12px;color:var(--t2);margin-bottom:6px}
.impact-red{color:var(--red)}
.impact-green{color:var(--grn)}
.feed-suggestion{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.sug-label{font-family:var(--mono);font-size:10px;color:var(--t3);text-transform:uppercase}
.sug-action{font-size:12px;font-weight:600;color:var(--t1)}
.feed-meta{}
.conf{font-family:var(--mono);font-size:10px;color:var(--t3)}

.stats-row{display:flex;align-items:center;justify-content:center;gap:48px;padding:48px 24px;background:var(--bg1);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.stat-item{display:flex;flex-direction:column;align-items:center;gap:4px}
.stat-num{font-family:var(--display);font-size:28px;font-weight:700;color:var(--t1)}
.stat-label{font-family:var(--mono);font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:0.5px}
.stat-divider{width:1px;height:40px;background:var(--border-md)}

.logos-bar{display:flex;flex-direction:column;align-items:center;gap:16px;padding:40px 24px;border-bottom:1px solid var(--border)}
.logos-label{font-family:var(--mono);font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:1px}
.logos-track{display:flex;gap:32px;flex-wrap:wrap;justify-content:center}
.logos-track span{font-family:var(--display);font-size:15px;font-weight:600;color:var(--t2);letter-spacing:-0.3px}

.how-it-works{padding:80px 24px;max-width:1000px;margin:0 auto}
.section-header{text-align:center;margin-bottom:48px}
.section-tag{font-family:var(--mono);font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:12px}
.section-header h2{font-family:var(--display);font-size:32px;font-weight:700;color:var(--t1)}
.steps-grid{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap}
.step-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:28px;max-width:280px;text-align:left}
.step-num{font-family:var(--mono);font-size:11px;color:var(--red);margin-bottom:12px;display:block}
.step-title{font-family:var(--display);font-size:18px;font-weight:600;color:var(--t1);margin-bottom:8px}
.step-desc{font-size:13px;color:var(--t2);line-height:1.5}
.step-arrow{color:var(--t3);flex-shrink:0}

.problem-section{padding:80px 24px;max-width:800px;margin:0 auto}
.problem-block{border:1px solid var(--border);border-radius:12px;background:var(--bg2);padding:52px 56px;text-align:center}
.problem-block p{font-size:clamp(17px,2.2vw,21px);line-height:1.7;color:var(--t2);max-width:560px;margin:0 auto}
.problem-block p strong{color:var(--t1);font-weight:500}
.problem-block .punch{font-family:var(--display);font-size:clamp(22px,3vw,34px);font-weight:700;color:var(--red);letter-spacing:-0.6px;margin-top:32px;padding-top:32px;text-shadow:0 0 40px var(--red-glow);border-top:1px solid rgba(184,50,50,0.2);display:inline-block}

.what-section{padding:80px 24px;max-width:1080px;margin:0 auto}
.section-header{text-align:center;margin-bottom:48px}
