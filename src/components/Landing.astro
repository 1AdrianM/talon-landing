<script>
function runAnalysis() {
  const inputState = document.getElementById('tool-input-state');
  const loadingState = document.getElementById('tool-loading');
  const resultState = document.getElementById('tool-result');

  inputState.style.display = 'none';
  loadingState.style.display = 'block';

  const fill = document.getElementById('loader-fill');
  const ls1 = document.getElementById('ls1');
  const ls2 = document.getElementById('ls2');
  const ls3 = document.getElementById('ls3');

  fill.style.width = '30%';
  ls1.classList.add('active');

  setTimeout(() => {
    fill.style.width = '60%';
    ls1.classList.remove('active');
    ls2.classList.add('active');
  }, 900);

  setTimeout(() => {
    fill.style.width = '92%';
    ls2.classList.remove('active');
    ls3.classList.add('active');
  }, 1800);

  setTimeout(() => {
    loadingState.style.display = 'none';
    resultState.style.display = 'block';
    resultState.style.opacity = '0';
    resultState.style.transform = 'translateY(8px)';
    resultState.style.transition = 'opacity .35s, transform .35s';
    setTimeout(() => {
      resultState.style.opacity = '1';
      resultState.style.transform = 'translateY(0)';
    }, 30);
  }, 2700);
}

function resetTool() {
  const inputState = document.getElementById('tool-input-state');
  const resultState = document.getElementById('tool-result');
  const ls1 = document.getElementById('ls1');
  const ls2 = document.getElementById('ls2');
  const ls3 = document.getElementById('ls3');

  resultState.style.display = 'none';
  inputState.style.display = 'block';
  document.getElementById('loader-fill').style.width = '0';
  ls1.classList.remove('active'); ls2.classList.remove('active'); ls3.classList.remove('active');
  ls1.classList.add('active');
}

function submitCapture() {
  const email = (document.getElementById('capture-email') as HTMLInputElement).value;
  const block = document.getElementById('capture-block');
  if (!email) { document.getElementById('capture-email').focus(); return; }
  block.innerHTML = '<p style="font-family:var(--mono);font-size:12px;color:var(--grn);text-align:center;padding:16px 0">✓ Saved — we\'ll alert you when this changes.</p>';
}

function toggleFaq(btn) {
  const item = btn.parentElement;
  item.classList.toggle('open');
  const icon = btn.querySelector('.faq-icon');
  icon.textContent = item.classList.contains('open') ? '−' : '+';
}

document.addEventListener('DOMContentLoaded', () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.what-item, .how-step, .testimonial, .faq-item, .pillar, .uc-card').forEach(el => {
    el.classList.add('fade-in');
    observer.observe(el);
  });

  const stickyCta = document.getElementById('sticky-cta');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      stickyCta.classList.add('show');
    } else {
      stickyCta.classList.remove('show');
    }
  });
});
</script>

