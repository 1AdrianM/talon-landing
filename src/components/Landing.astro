    <div class="why-cell">
      <div class="why-cell-label">Talon</div>
      <div class="why-cell-title bright">Drop to $187 — you're losing $510/day</div>
    </div>
  </div>
  <div class="pillars">
    <div class="pillar">
      <div class="pillar-icon"><Icon name="zap" size="18" /></div>
      <div class="pillar-title">Instant analysis</div>
      <div class="pillar-desc">Results in seconds, not after a 3-hour manual review session.</div>
    </div>
    <div class="pillar">
      <div class="pillar-icon"><Icon name="brain" size="18" /></div>
      <div class="pillar-title">Clear reasoning</div>
      <div class="pillar-desc">Plain-language explanations — not just numbers, but the why behind them.</div>
    </div>
    <div class="pillar">
      <div class="pillar-icon"><Icon name="target" size="18" /></div>
      <div class="pillar-title">Direct actions</div>
      <div class="pillar-desc">Built for operators who need to move fast, not analysts building decks.</div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-inner">
    <div class="cta-content">
      <span class="cta-tag">Ready?</span>
      <h2>Your competitors are adjusting prices right now.</h2>
      <p>Every minute you wait, you're leaving money on the table. Stop guessing — start tracking.</p>
      <div class="cta-actions">
        <button class="btn-primary btn-lg" onclick="document.getElementById('product-url').focus(); document.getElementById('analyzer').scrollIntoView({behavior:'smooth'})">
          Analyze your product →
        </button>
        <span class="cta-note">Free to start · No credit card</span>
      </div>
    </div>
    <div class="cta-visual">
      <div class="cta-card">
        <div class="cta-card-header">
          <span class="cta-card-icon">⚡</span>
          <span class="cta-card-title">Today's Insight</span>
        </div>
        <div class="cta-card-body">
          <div class="cta-stat">
            <span class="cta-stat-num">12</span>
            <span class="cta-stat-label">price changes detected</span>
          </div>
          <div class="cta-stat">
            <span class="cta-stat-num">3</span>
            <span class="cta-stat-label">opportunities found</span>
          </div>
          <div class="cta-stat">
            <span class="cta-stat-num">$847</span>
            <span class="cta-stat-label">potential revenue</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/talon-logo.png" alt="Talon" class="footer-logo" />
      <span>Talon</span>
    </div>
    <span class="footer-tag">Pricing Intelligence for Ecommerce</span>
    <div class="footer-links">
      <a href="/resources">Resources</a>
      <a href="#how">How it works</a>
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
    </div>
  </div>
</footer>

<script>
function handleSubmit(e) {
  e.preventDefault();
  const input = document.getElementById('product-url');
  const url = input.value.trim();
  if (!url) return false;
  const encoded = encodeURIComponent(url);
  window.location.href = '/analyze?url=' + encoded;
  return false;
}

function toggleFaq(btn) {
  const item = btn.parentElement;
  item.classList.toggle('open');
  const icon = btn.querySelector('.faq-icon');
  icon.textContent = item.classList.contains('open') ? '−' : '+';
}

document.addEventListener('DOMContentLoaded', () => {
  const stickyBar = document.getElementById('sticky-bar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      stickyBar.classList.add('show');
    } else {
      stickyBar.classList.remove('show');
    }
  });

  const ssItems = document.querySelectorAll('.ss-item');
  if (ssItems.length > 0) {
    let ssCurrent = 0;
    setInterval(() => {
      ssItems[ssCurrent].classList.remove('ss-active');
      ssCurrent = (ssCurrent + 1) % ssItems.length;
      ssItems[ssCurrent].classList.add('ss-active');
    }, 2000);
  }
});
</script>

<style>
.site-header{position:sticky;top:0;z-index:100;background:rgba(9,9,11,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.header-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;padding:16px 24px}
.header-logo{display:flex;align-items:center;gap:8px;text-decoration:none}
.logo-img{width:36px;height:36px;object-fit:contain;border-radius:8px}
.logo-text{font-family:var(--display);font-size:18px;font-weight:700;color:var(--t1)}
.header-nav{display:flex;gap:32px}
.nav-link{font-family:var(--sans);font-size:14px;color:var(--t2);text-decoration:none;transition:color .15s}
.nav-link:hover{color:var(--t1)}
.header-right{display:flex;align-items:center}
.header-right .btn-primary{background:var(--t1);color:var(--bg0);border:none;box-shadow:none}
.btn-primary{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;padding:10px 20px;border-radius:8px;background:var(--t1);color:var(--bg0);border:none;cursor:pointer;transition:opacity .15s,transform .15s,box-shadow .15s;white-space:nowrap}
.btn-primary:hover{opacity:0.9;transform:translateY(-1px)}
.btn-primary .arr{transition:transform .15s}
.btn-primary:hover .arr{transform:translateX(3px)}

.sticky-bar{position:fixed;bottom:-60px;left:0;right:0;z-index:99;display:flex;align-items:center;justify-content:center;gap:20px;padding:16px 24px;background:rgba(15,15,18,0.98);border-top:1px solid var(--border);transition:bottom .3s ease;box-shadow:0 -4px 20px rgba(0,0,0,0.4)}
.sticky-bar.show{bottom:0}
.sticky-bar span{font-size:14px;color:var(--t2)}
.sticky-bar button{font-size:13px;font-weight:600;color:var(--t1);background:none;border:none;cursor:pointer;text-decoration:underline}

.hero-split{display:grid;grid-template-columns:1fr 1.1fr;gap:40px;max-width:1200px;margin:0 auto;padding:64px 24px 56px;align-items:start}
.hero-left{}
.hero-eyebrow{font-family:var(--mono);font-size:11px;color:var(--red);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.hero-eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red-glow);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
h1{font-family:var(--display);font-size:clamp(28px,3.5vw,40px);font-weight:800;line-height:1.15;color:var(--t1);margin-bottom:14px;max-width:520px}
.hero-sub{font-size:15px;color:var(--t2);line-height:1.55;margin-bottom:16px;max-width:460px}
.hero-icp{display:flex;align-items:center;gap:8px;margin-bottom:20px;font-family:var(--mono);font-size:11px;color:var(--t3)}
.hero-icp span{color:var(--t2)}
.icp-div{color:var(--t3)}

.analyzer-box{background:var(--bg1);border:1px solid var(--border);border-radius:10px;padding:18px;max-width:500px;position:relative}
.analyzer-box::before{content:'Add product';position:absolute;top:-9px;left:16px;background:var(--bg0);padding:2px 10px;font-family:var(--mono);font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:0.5px;border:1px solid var(--border);border-radius:4px}
.analyzer-form{display:flex;gap:10px;margin-bottom:8px}
.analyzer-input{flex:1;padding:12px 14px;background:var(--bg2);border:1px solid var(--border-md);border-radius:6px;color:var(--t1);font-size:13px;outline:none;transition:border-color .15s,box-shadow .15s}
.analyzer-input::placeholder{color:var(--t3)}
.analyzer-input:focus{border-color:var(--t2);box-shadow:0 0 0 3px rgba(237,236,234,0.05)}
.analyzer-btn{padding:12px 20px;background:var(--t1);color:var(--bg0);border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:opacity .15s,transform .15s}
.analyzer-btn:hover{opacity:0.9;transform:translateY(-1px)}
.analyzer-note{font-family:var(--mono);font-size:10px;color:var(--t3)}

.hero-right{}
.live-feed{background:var(--bg1);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.2)}
.feed-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg2);border-bottom:1px solid var(--border)}
.feed-title{font-family:var(--mono);font-size:11px;color:var(--t1);font-weight:500}
.feed-status{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:var(--t3)}
.status-dot{width:5px;height:5px;border-radius:50%;background:var(--grn);box-shadow:0 0 8px var(--grn-glow);animation:pulse-green 2s infinite}
.status-text{color:var(--t2)}
@keyframes pulse-green{0%,100%{opacity:1;box-shadow:0 0 8px var(--grn-glow)}50%{opacity:0.6;box-shadow:0 0 4px var(--grn-glow)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.4}}
.feed-item{padding:14px 16px;border-bottom:1px solid var(--border-md);transition:background .15s}
.feed-item:last-child{border-bottom:none}
.feed-item:hover{background:var(--bg2)}
.feed-item{animation:fadeIn 0.5s ease forwards;opacity:0}
.feed-item:nth-child(2){animation-delay:0.1s}
.feed-item:nth-child(3){animation-delay:0.2s}
.feed-item:nth-child(4){animation-delay:0.3s}
.feed-item:nth-child(5){animation-delay:0.4s}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.feed-item-red{border-left:3px solid var(--red);background:rgba(184,50,50,0.03)}
.feed-item-red:hover{background:rgba(184,50,50,0.06)}
.feed-item-green{border-left:3px solid var(--grn);background:rgba(26,158,104,0.03)}
.feed-item-green:hover{background:rgba(26,158,104,0.06)}
.feed-item-amber{border-left:3px solid var(--amb)}
.feed-time{font-family:var(--mono);font-size:9px;color:var(--t3);margin-bottom:3px}
.feed-store{font-family:var(--display);font-size:12px;font-weight:600;color:var(--t1);margin-bottom:3px}
.feed-action{font-size:12px;color:var(--t2);margin-bottom:4px}
.feed-impact{font-family:var(--mono);font-size:11px;color:var(--t2);margin-bottom:4px}
.impact-red{color:var(--red);font-weight:600}
.impact-green{color:#1DB87A;font-weight:600}
.feed-suggestion{display:flex;align-items:center;gap:6px;margin-bottom:3px}
.sug-label{font-family:var(--mono);font-size:9px;color:var(--t3);text-transform:uppercase}
.sug-action{font-size:11px;font-weight:600;color:var(--t1)}
