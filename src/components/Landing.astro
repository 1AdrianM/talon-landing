      <div class="hero-input-wrap">
        <input class="hero-input" type="url" placeholder="https://yourstore.com/product" id="product-url"/>
        <button class="hero-btn" onclick="handleSubmit()">Analyze →</button>
      </div>
    </div>
    <span class="hero-trust">No signup required · Results in seconds</span>
  </div>
  <div class="hero-right">
    <div class="live-feed">
      <div class="lf-header">
        <span class="lf-title">Live Pricing Feed</span>
        <span class="lf-live"><span class="lf-dot"></span> Tracking 4 products</span>
      </div>
      <div class="lf-event lf-event-r">
        <div class="lf-row1">
          <div>
            <div class="lf-store">NikeStore.com</div>
            <div class="lf-desc">Dropped Air Force 1'07 by 12%</div>
          </div>
          <span class="lf-time">2 min ago</span>
        </div>
        <div class="lf-row2">
          <span class="lf-impact lf-impact-r">−$38/day</span>
          <span class="lf-suggestion"><span class="lf-suggestion-label">Talon suggests</span> Match to $109 →</span>
        </div>
        <span class="lf-conf">92% confidence</span>
      </div>
      <div class="lf-event lf-event-g">
        <div class="lf-row1">
          <div>
            <div class="lf-store">FinishLine</div>
            <div class="lf-desc">Raised Jordan 1 by 5%</div>
          </div>
          <span class="lf-time">8 min ago</span>
        </div>
        <div class="lf-row2">
          <span class="lf-impact lf-impact-g">+$22/day</span>
          <span class="lf-suggestion"><span class="lf-suggestion-label">Talon suggests</span> Raise to $145 →</span>
        </div>
        <span class="lf-conf">87% confidence</span>
      </div>
      <div class="lf-event lf-event-a">
        <div class="lf-row1">
          <div>
            <div class="lf-store">StockX</div>
            <div class="lf-desc">Supply squeeze detected — Yeezy 350</div>
          </div>
          <span class="lf-time">14 min ago</span>
        </div>
        <div class="lf-row2">
          <span class="lf-impact lf-impact-a">Market moving</span>
          <span class="lf-suggestion"><span class="lf-suggestion-label">Talon suggests</span> Increase stock →</span>
        </div>
        <span class="lf-conf">78% confidence</span>
      </div>
      <div class="lf-event lf-event-g">
        <div class="lf-row1">
          <div>
            <div class="lf-store">JD Sports</div>
            <div class="lf-desc">Restocked Air Max 90</div>
          </div>
          <span class="lf-time">30 min ago</span>
        </div>
        <div class="lf-row2">
          <span class="lf-impact lf-impact-g">+$15/day</span>
          <span class="lf-suggestion"><span class="lf-suggestion-label">Talon suggests</span> Raise to $165 →</span>
