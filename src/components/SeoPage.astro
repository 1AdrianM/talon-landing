---
import TalonLogo from './TalonLogo.astro';
import { AnalyzerHero } from './AnalyzerHero';

interface Props {
  title: string;
  description: string;
  slug: string;
  heroEyebrow?: string;
  heroHeadline: string;
  heroSubheadline: string;
  ctaPrimary?: string;
  actionTitle?: string;
  actionText?: string;
}

const {
  title,
  description,
  slug,
  heroEyebrow = "Free Tool",
  heroHeadline,
  heroSubheadline,
  ctaPrimary = "Check my price",
  actionTitle,
  actionText,
} = Astro.props;
---

<nav>
  <div class="nav-logo">
    <a href="/" class="nav-logo-link">
      <TalonLogo size={24} />
      <span class="logo-name">Talon</span>
    </a>
  </div>
  <div class="nav-right">
    <a href="/" class="nav-link">Home</a>
    <a href="#tool" class="nav-cta">Check my price →</a>
  </div>
</nav>

<section class="hero">
  <div class="hero-eyebrow">{heroEyebrow}</div>
  <h1>{heroHeadline}</h1>
  <p class="hero-sub">{heroSubheadline}</p>
  <div class="cta-group">
    <a href="#tool" class="btn-primary">
      <span class="arr" aria-hidden="true">→</span> {ctaPrimary}
    </a>
    <span class="cta-note">No signup required · Free analysis</span>
  </div>
</section>

<section class="tool-section" id="tool">
  <div class="tool-inner">
    <div class="tool-tag">Free Price Check</div>
    <h2 class="tool-title">Check your product now</h2>
    <AnalyzerHero client:load />
    <p class="tool-note">Early access: we're onboarding the first stores by hand.</p>
  </div>
</section>

{(actionTitle || actionText) && (
  <section class="action-section">
    <div class="sec-inner">
      <div class="sec-tag">What to do next</div>
      <h2 class="sec-title">{actionTitle ?? "Take action"}</h2>
      {actionText && <p class="sec-sub">{actionText}</p>}
      <div class="action-cards">
        <div class="action-card">
          <div class="action-content">
            <h3>Analyze your product</h3>
            <p>Get a price verdict for your specific product — free, no signup.</p>
          </div>
          <a href="#tool" class="btn-primary btn-sm">Check my price →</a>
        </div>
        <div class="action-card">
          <div class="action-content">
            <h3>Get alerts when prices change</h3>
            <p>Leave your email and we'll notify you when the picture changes. Monitoring is in early access.</p>
          </div>
          <a href="/#early-access" class="btn-secondary btn-sm">Get early access →</a>
        </div>
      </div>
    </div>
  </section>
)}

<section class="final-cta">
  <h2>Stop guessing. Start pricing with context.</h2>
  <p class="final-sub">See where you stand — and what to do next.</p>
  <div class="cta-group">
    <a href="#tool" class="btn-primary btn-lg">
      <span class="arr" aria-hidden="true">→</span> Check my price now
    </a>
    <span class="cta-note">Free · No signup required</span>
  </div>
</section>

<footer>
  <div class="footer-logo">
    <a href="/" class="footer-logo-link">
      <TalonLogo size={22} />
      <span>Talon</span>
    </a>
  </div>
  <span class="footer-tagline">Pricing Decision Engine · Early access</span>
  <div class="footer-links">
    <a href="/">Home</a>
    <a href="/privacy">Privacy</a>
    <a href="mailto:hello@trytalon.com">Contact</a>
  </div>
</footer>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

nav {
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px; height: 54px;
  background: rgba(251,247,240,0.92); backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
}
.nav-logo-link { display: flex; align-items: center; gap: 6px; text-decoration: none; }
.logo-name { font-family: var(--display); font-size: 16px; font-weight: 700; color: var(--ink); }
.nav-right { display: flex; align-items: center; gap: 16px; }
.nav-link { font-size: 13px; color: var(--ink-2); text-decoration: none; transition: color .15s; }
.nav-link:hover { color: var(--ink); }
.nav-cta {
  font-size: 13px; font-weight: 600; padding: 8px 18px;
  border-radius: 8px; background: var(--accent); color: var(--accent-ink);
  text-decoration: none; transition: opacity .15s;
}
.nav-cta:hover { opacity: .9; }

.hero {
  text-align: center; padding: 80px 40px 60px;
  max-width: 800px; margin: 0 auto;
}
.hero-eyebrow {
  display: inline-block; font-family: var(--mono); font-size: 11px;
  color: var(--hold); border: 1px solid var(--hold-bd); background: var(--hold-bg);
  padding: 4px 12px; border-radius: 20px; margin-bottom: 24px; letter-spacing: 0.3px;
}
h1 {
  font-family: var(--display); font-size: clamp(30px, 4.5vw, 48px);
  font-weight: 800; letter-spacing: -1px; line-height: 1.1;
  color: var(--ink); margin-bottom: 16px; max-width: 680px; margin-left: auto; margin-right: auto;
}
.hero-sub {
  font-size: clamp(15px, 1.8vw, 17px); color: var(--ink-2);
  max-width: 520px; margin: 0 auto 28px; line-height: 1.65;
}
.cta-group { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--sans); font-size: 15px; font-weight: 600;
  padding: 13px 26px; border-radius: var(--radius);
  background: var(--ink); color: var(--surface); text-decoration: none;
  border: none; cursor: pointer; transition: opacity .15s, transform .15s;
}
.btn-primary:hover { opacity: .88; transform: translateY(-1px); }
.btn-primary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.btn-primary .arr { transition: transform .15s; }
.btn-primary:hover .arr { transform: translateX(3px); }
.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--sans); font-size: 15px; font-weight: 600;
  padding: 13px 26px; border-radius: var(--radius);
  background: transparent; color: var(--ink);
  border: 1.5px solid var(--line); text-decoration: none; cursor: pointer;
  transition: border-color .15s;
}
.btn-secondary:hover { border-color: var(--ink-2); }
.btn-sm { padding: 9px 18px; font-size: 13px; }
.btn-lg { padding: 15px 30px; font-size: 16px; }
.cta-note { font-family: var(--mono); font-size: 11px; color: var(--hold); }

.tool-section { padding: 48px 40px; background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.tool-inner { max-width: 600px; margin: 0 auto; }
.tool-tag {
  font-family: var(--mono); font-size: 10px; text-transform: uppercase;
  letter-spacing: 1px; color: var(--hold); margin-bottom: 10px;
}
.tool-title { font-family: var(--display); font-size: 24px; font-weight: 700; color: var(--ink); margin-bottom: 20px; }
.tool-note { font-family: var(--mono); font-size: 11px; color: var(--hold); margin-top: 14px; }

.action-section { padding: 80px 40px; background: var(--bg); border-bottom: 1px solid var(--line); }
.sec-inner { max-width: 860px; margin: 0 auto; }
.sec-tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--hold); margin-bottom: 8px; }
.sec-title { font-family: var(--display); font-size: clamp(22px, 3.5vw, 32px); font-weight: 700; letter-spacing: -0.6px; color: var(--ink); margin-bottom: 10px; }
.sec-sub { font-size: 14px; color: var(--ink-2); margin-bottom: 28px; line-height: 1.65; max-width: 480px; }
.action-cards { display: flex; flex-direction: column; gap: 12px; max-width: 560px; }
.action-card {
  display: flex; align-items: center; gap: 20px;
  padding: 20px; background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--radius);
}
.action-content { flex: 1; }
.action-content h3 { font-family: var(--display); font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
.action-content p { font-size: 13px; color: var(--ink-2); }

.final-cta { text-align: center; padding: 80px 40px; max-width: 760px; margin: 0 auto; }
.final-cta h2 { font-family: var(--display); font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; letter-spacing: -0.8px; color: var(--ink); margin-bottom: 10px; }
.final-sub { font-size: 16px; color: var(--ink-2); margin-bottom: 28px; }

footer {
  border-top: 1px solid var(--line); padding: 22px 40px;
  display: flex; align-items: center; justify-content: space-between; gap: 20px; background: var(--bg);
}
.footer-logo-link { display: flex; align-items: center; gap: 6px; text-decoration: none; }
.footer-logo { font-family: var(--display); font-size: 14px; font-weight: 700; color: var(--ink); }
.footer-tagline { font-family: var(--mono); font-size: 11px; color: var(--hold); flex: 1; text-align: center; }
.footer-links { display: flex; gap: 20px; }
.footer-links a { font-family: var(--mono); font-size: 11px; color: var(--hold); text-decoration: none; transition: color .15s; }
.footer-links a:hover { color: var(--ink); }

@media (max-width: 768px) {
  nav { padding: 0 20px; }
  .hero, .tool-section, .action-section, .final-cta { padding-left: 24px; padding-right: 24px; }
  .action-card { flex-direction: column; text-align: center; }
  footer { flex-direction: column; gap: 12px; text-align: center; }
  .footer-tagline { text-align: center; }
  .footer-links { justify-content: center; flex-wrap: wrap; }
}
</style>
