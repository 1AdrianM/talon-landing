---
import TalonLogo from './TalonLogo.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  readTime: string;
  published?: string;
  updated?: string;
}

const { title, description, category, readTime, published, updated } = Astro.props;
---

<nav class="topnav">
  <a href="/" class="nav-logo">
    <TalonLogo size={24} />
    <span class="logo-name">Talon</span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/resources" class="nav-link active">Resources</a>
  </div>
  <a href="/#early-access" class="nav-cta">Get early access →</a>
</nav>

<div class="page">
  <div class="breadcrumb">
    <a href="/" class="bc-link">Home</a>
    <span class="bc-sep">/</span>
    <a href="/resources" class="bc-link">Resources</a>
    <span class="bc-sep">/</span>
    <span class="bc-current">{title.toLowerCase()}</span>
  </div>

  <header class="article-header">
    <div class="article-cat">{category}</div>
    <h1 class="article-h1">{title}</h1>
    <p class="article-deck">{description}</p>
    <div class="article-meta">
      <div class="meta-author">
        <div class="meta-avatar">T</div>
        <span class="meta-name">Talon Team</span>
      </div>
      <div class="meta-sep"></div>
      {published && <span class="meta-item">📅 {published}</span>}
      {published && <div class="meta-sep"></div>}
      <span class="meta-item">⏱ {readTime}</span>
      {updated && <><div class="meta-sep"></div><span class="meta-updated">Updated {updated}</span></>}
    </div>
  </header>

  <div class="article-layout">
    <article class="article-body">
      <slot />
    </article>
    <aside class="article-sidebar">
      <slot name="sidebar" />
    </aside>
  </div>
</div>

<footer class="footer">
  <div class="footer-logo">
    <TalonLogo size={20} />
    <span>Talon</span>
  </div>
  <span class="footer-tagline">Pricing Decision Engine · Early access</span>
  <div class="footer-links">
    <a href="/">Home</a>
    <a href="/privacy">Privacy</a>
    <a href="mailto:hello@trytalon.com">Contact</a>
  </div>
</footer>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.topnav {
  height: 54px; display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px; border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 100;
  background: rgba(251,247,240,0.92); backdrop-filter: blur(12px);
}
.nav-logo { display: flex; align-items: center; gap: 6px; text-decoration: none; }
.logo-name { font-family: var(--display); font-size: 16px; font-weight: 700; color: var(--ink); }
.nav-links { display: flex; align-items: center; gap: 4px; }
.nav-link { font-size: 13px; color: var(--ink-2); text-decoration: none; padding: 6px 10px; border-radius: 6px; transition: color .15s; }
.nav-link:hover { color: var(--ink); }
.nav-link.active { color: var(--ink); }
.nav-cta {
  font-size: 13px; font-weight: 600; padding: 7px 16px;
  border-radius: 8px; background: var(--accent); color: var(--accent-ink);
  text-decoration: none; transition: opacity .15s;
}
.nav-cta:hover { opacity: .9; }

.page { max-width: 1160px; margin: 0 auto; padding: 0 32px; }

.breadcrumb { display: flex; align-items: center; gap: 8px; padding: 24px 0 0; font-family: var(--mono); font-size: 11px; color: var(--hold); }
.bc-sep { color: var(--line); }
.bc-link { color: var(--hold); text-decoration: none; }
.bc-link:hover { color: var(--ink); }
.bc-current { color: var(--ink-2); }

.article-header { padding: 28px 0 32px; max-width: 780px; }
.article-cat {
  display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono);
  font-size: 11px; color: var(--hold); background: var(--hold-bg);
  border: 1px solid var(--hold-bd); padding: 4px 12px; border-radius: 20px;
  margin-bottom: 18px; letter-spacing: 0.3px;
}
.article-h1 {
  font-family: var(--display); font-size: clamp(26px, 3.8vw, 40px);
  font-weight: 800; letter-spacing: -0.8px; line-height: 1.12; color: var(--ink); margin-bottom: 16px;
}
.article-deck { font-size: 17px; color: var(--ink-2); line-height: 1.65; max-width: 640px; margin-bottom: 20px; }
.article-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.meta-author { display: flex; align-items: center; gap: 8px; }
.meta-avatar {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--hold-bg); border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: var(--ink-2);
}
.meta-name { font-size: 13px; font-weight: 500; color: var(--ink-2); }
.meta-sep { width: 1px; height: 14px; background: var(--line); }
.meta-item { font-family: var(--mono); font-size: 11px; color: var(--hold); }
.meta-updated { font-family: var(--mono); font-size: 11px; color: var(--hold); }

.article-layout { display: grid; grid-template-columns: 1fr 260px; gap: 56px; align-items: start; padding-bottom: 80px; }
.article-body { min-width: 0; }
.article-sidebar { position: sticky; top: 70px; display: flex; flex-direction: column; gap: 20px; }

.footer {
  border-top: 1px solid var(--line); padding: 22px 32px;
  display: flex; align-items: center; justify-content: space-between; gap: 20px; background: var(--bg);
}
.footer-logo { display: flex; align-items: center; gap: 6px; font-family: var(--display); font-size: 14px; font-weight: 700; color: var(--ink); }
.footer-tagline { font-family: var(--mono); font-size: 11px; color: var(--hold); }
.footer-links { display: flex; gap: 20px; }
.footer-links a { font-family: var(--mono); font-size: 11px; color: var(--hold); text-decoration: none; transition: color .15s; }
.footer-links a:hover { color: var(--ink); }

@media (max-width: 900px) {
  .article-layout { grid-template-columns: 1fr; }
  .article-sidebar { position: static; flex-direction: row; flex-wrap: wrap; }
}
@media (max-width: 640px) {
  .topnav, .page, .footer { padding-left: 20px; padding-right: 20px; }
  .footer { flex-direction: column; gap: 12px; text-align: center; }
  .footer-links { justify-content: center; }
}
</style>
